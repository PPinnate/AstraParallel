+/* Completion-valued form for ownership barriers.  The legacy wait
+ * returns a profiling iteration count and may leave on fatal/device loss.
+ * Keep the actual head/sequence predicate private to the ring module. */
+bool
+npt_ring_wait_seqno_complete(struct npt_ring *ring, uint32_t seqno)
+{
+   if (!ring)
+      return false;
+   npt_ring_wait_seqno(ring, seqno);
+   return npt_ring_seqno_status(ring, seqno);
+}
