diff --git a/src/neptune/npt_bc6_upload_check.c b/src/neptune/npt_bc6_upload_check.c
new file mode 100644
index e69de29bb2d1d6434b8b29ae775ad8c2e48c5391..2cd4befa4243a6835cfa2cec440b8a608acadda9
--- /dev/null
+++ b/src/neptune/npt_bc6_upload_check.c
@@ -0,0 +1,372 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT
+ */
+#include "npt_bc6_upload_check.h"
+
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "npt_com.h"
+#include "npt_context.h"
+
+static bool
+npt_bc6_now(uint64_t *ns)
+{
+   struct timespec ts;
+   if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+      return false;
+   *ns = (uint64_t)ts.tv_sec * UINT64_C(1000000000) + ts.tv_nsec;
+   return true;
+}
+
+static uint64_t
+npt_bc6_elapsed_ms(const struct npt_bc6_upload_check_state *s, uint64_t now)
+{
+   return s->started && now >= s->first_upload_ns
+             ? (now - s->first_upload_ns) / UINT64_C(1000000) : 0;
+}
+
+static bool
+npt_bc6_parse_name(const char *name, size_t len,
+                    struct npt_bc6_upload_check_state *s)
+{
+   static const char prefix[] = "nptw pid=";
+   if (!name || strlen(name) != len || strncmp(name, prefix, sizeof(prefix) - 1))
+      return false;
+   const char *p = name + sizeof(prefix) - 1;
+   uint32_t value = 0;
+   if (*p < '0' || *p > '9')
+      return false;
+   do {
+      unsigned digit = (unsigned)(*p++ - '0');
+      if (value > (UINT32_MAX - digit) / 10)
+         return false;
+      value = value * 10 + digit;
+   } while (*p >= '0' && *p <= '9');
+   if (!value || strncmp(p, " exe=", 5))
+      return false;
+   static const char *const clients[] = {"GenshinImpact.exe", "AstraBC6.exe"};
+   for (unsigned i = 0; i < ARRAY_SIZE(clients); i++) {
+      char expected[96];
+      int expected_len = snprintf(expected, sizeof(expected),
+                                  "nptw pid=%u exe=%s", value, clients[i]);
+      bool full = expected_len > 0 && (size_t)expected_len == len &&
+                  !strcmp(name, expected);
+      /* The live transport has supplied exactly 31 characters even though
+       * the source context tag buffer is larger. Accept only this explicit
+       * truncation of an exact generated tag, retaining >=8 basename bytes.
+       * A truncated tag alone is not full process identity; the collector
+       * must independently join the full Present client name and guest PID. */
+      bool truncated = expected_len > 31 && len == 31 &&
+                       (size_t)(p + 5 - name) <= 31 - 8 &&
+                       !strncmp(name, expected, 31);
+      if (full || truncated) {
+         s->guest_pid = value;
+         s->client = clients[i];
+         s->tag_truncated = truncated;
+         return true;
+      }
+   }
+   return false;
+}
+
+/* Called with the mutex held, or during initialization before publication. */
+static void
+npt_bc6_summary(struct npt_context *ctx, const char *reason, uint64_t now)
+{
+   struct npt_bc6_upload_check_state *s = &ctx->bc6_upload_check;
+   if (s->summary_emitted)
+      return;
+   s->summary_emitted = s->stopped = true;
+   npt_log("BC6UploadSummary {\"schema\":\"astra-bc6-upload-summary-1\","
+           "\"event\":\"BC6UploadSummary\",\"guest_pid\":%u,\"hostpid\":%ld,"
+           "\"client\":\"%s\",\"tag_truncated\":%s,"
+           "\"transport_ctx\":%u,\"reason\":\"%s\",\"resources\":%u,"
+           "\"updates\":%u,\"readbacks\":%u,\"comparisons\":%u,"
+           "\"matches\":%u,\"mismatches\":%u,\"skipped\":%u,\"failed\":%u,"
+           "\"tight_bytes_budgeted\":%" PRIu64 ",\"compared_bytes\":%" PRIu64 ","
+           "\"elapsed_ms\":%" PRIu64 "}",
+           s->guest_pid, (long)getpid(), s->client,
+           s->tag_truncated ? "true" : "false", ctx->ctx_id, reason, s->resources,
+           s->updates, s->readbacks, s->comparisons, s->matches, s->mismatches,
+           s->skipped, s->failed, s->tight_bytes_budgeted, s->compared_bytes,
+           npt_bc6_elapsed_ms(s, now));
+}
+
+void
+npt_bc6_upload_check_init(struct npt_context *ctx, size_t debug_len)
+{
+   struct npt_bc6_upload_check_state *s = &ctx->bc6_upload_check;
+   const char *env = getenv("ASTRA_BC6_UPLOAD_CHECK");
+   if (!env || strcmp(env, "1") ||
+       !npt_bc6_parse_name(ctx->debug_name, debug_len, s))
+      return;
+   if (mtx_init(&s->mutex, mtx_plain) != thrd_success) {
+      npt_bc6_summary(ctx, "mutex_init_failed", 0);
+      return;
+   }
+   s->enabled = true;
+}
+
+void
+npt_bc6_upload_check_fini(struct npt_context *ctx)
+{
+   struct npt_bc6_upload_check_state *s = &ctx->bc6_upload_check;
+   if (!s->enabled)
+      return;
+   mtx_lock(&s->mutex);
+   uint64_t now = 0;
+   bool clock_ok = npt_bc6_now(&now);
+   npt_bc6_summary(ctx, clock_ok ? "teardown" : "clock_failed", now);
+   mtx_unlock(&s->mutex);
+   mtx_destroy(&s->mutex);
+}
+
+static uint64_t
+npt_bc6_hash_rows(const uint8_t *data, uint32_t pitch, uint32_t rows,
+                   uint32_t tight_row, uint32_t *reserved)
+{
+   uint64_t hash = UINT64_C(14695981039346656037);
+   *reserved = 0;
+   for (uint32_t y = 0; y < rows; y++) {
+      const uint8_t *row = data + (size_t)y * pitch;
+      for (uint32_t x = 0; x < tight_row; x++) {
+         hash ^= row[x];
+         hash *= UINT64_C(1099511628211);
+      }
+      for (uint32_t x = 0; x < tight_row; x += 16) {
+         unsigned mode = row[x] & 31;
+         if ((row[x] & 3) == 3 &&
+             (mode == 19 || mode == 23 || mode == 27 || mode == 31))
+            (*reserved)++;
+      }
+   }
+   return hash;
+}
+
+void
+npt_bc6_upload_check(struct npt_context *ctx, void *resource,
+                      ID3D11Device *device, ID3D11DeviceContext *imm_ctx,
+                      uint64_t resource_id, uint32_t subresource,
+                      uint32_t row_pitch, uint32_t byte_size,
+                      bool has_box, const void *payload)
+{
+   struct npt_bc6_upload_check_state *s = &ctx->bc6_upload_check;
+   if (!s->enabled)
+      return;
+   mtx_lock(&s->mutex);
+   if (s->stopped)
+      goto unlock;
+
+   D3D11_RESOURCE_DIMENSION dimension = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+   PFN_ID3D11Resource_GetType get_type = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11Resource_GetType, npt_com_vtable(resource),
+      NPT_VTBL_ID3D11Resource_GetType);
+   get_type(resource, &dimension);
+   if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+      goto unlock;
+   D3D11_TEXTURE2D_DESC desc;
+   PFN_ID3D11Texture2D_GetDesc get_desc = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11Texture2D_GetDesc, npt_com_vtable(resource),
+      NPT_VTBL_ID3D11Texture2D_GetDesc);
+   get_desc(resource, &desc);
+   if (desc.Format != DXGI_FORMAT_BC6H_UF16 || desc.Width != 128 ||
+       desc.Height != 128 || desc.MipLevels != 8 || desc.ArraySize != 6 ||
+       desc.SampleDesc.Count != 1 || desc.Usage != D3D11_USAGE_DEFAULT)
+      goto unlock;
+
+   uint64_t now = 0;
+   if (!npt_bc6_now(&now)) {
+      npt_bc6_summary(ctx, "clock_failed", 0);
+      goto unlock;
+   }
+   if (s->started && now - s->first_upload_ns >= NPT_BC6_UPLOAD_MAX_NS) {
+      npt_bc6_summary(ctx, "deadline", now);
+      goto unlock;
+   }
+   if (s->updates >= NPT_BC6_UPLOAD_MAX_UPDATES) {
+      npt_bc6_summary(ctx, "update_cap", now);
+      goto unlock;
+   }
+   uint32_t id_index = 0;
+   while (id_index < s->resources && s->resource_ids[id_index] != resource_id)
+      id_index++;
+   if (id_index == s->resources) {
+      if (s->resources == NPT_BC6_UPLOAD_MAX_RESOURCES) {
+         npt_bc6_summary(ctx, "resource_cap", now);
+         goto unlock;
+      }
+      s->resource_ids[s->resources++] = resource_id;
+   }
+
+   uint32_t mip = subresource % 8;
+   uint32_t side = 128u >> mip;
+   uint32_t rows = (side + 3) / 4;
+   uint32_t tight_row = rows * 16;
+   uint32_t tightbytes = rows * tight_row;
+   const char *status = "skipped";
+   const char *step = "has_box";
+   const char *stop_reason = NULL;
+   char hr_json[32] = "null";
+   char expected_hash_json[32] = "null", actual_hash_json[32] = "null";
+   char expected_reserved_json[32] = "null", actual_reserved_json[32] = "null";
+   char mismatch_json[32] = "null", first_json[160] = "";
+   ID3D11Texture2D *staging = NULL;
+   uint32_t mismatch_count = 0;
+   s->updates++;
+
+   if (has_box)
+      goto report;
+   if (subresource >= 48) {
+      step = "invalid_subresource";
+      goto report;
+   }
+   if (!s->started) {
+      s->started = true;
+      s->first_upload_ns = now;
+   }
+   if (!payload || row_pitch < tight_row ||
+       (uint64_t)(rows - 1) * row_pitch + tight_row > byte_size) {
+      step = "invalid_payload_extent";
+      goto report;
+   }
+   if (s->tight_bytes_budgeted + tightbytes > NPT_BC6_UPLOAD_MAX_BYTES) {
+      step = "byte_cap";
+      stop_reason = "byte_cap";
+      goto report;
+   }
+   /* Reserve the whole tight extent before touching payload, even if a
+    * subsequent D3D operation fails. No padded or allocation-wide dumps. */
+   s->tight_bytes_budgeted += tightbytes;
+   uint32_t expected_reserved;
+   uint64_t expected_hash = npt_bc6_hash_rows(payload, row_pitch, rows,
+                                              tight_row, &expected_reserved);
+   snprintf(expected_hash_json, sizeof(expected_hash_json),
+            "\"%016" PRIx64 "\"", expected_hash);
+   snprintf(expected_reserved_json, sizeof(expected_reserved_json),
+            "%u", expected_reserved);
+
+   desc.ArraySize = 1;
+   desc.Usage = D3D11_USAGE_STAGING;
+   desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+   desc.BindFlags = desc.MiscFlags = 0;
+   PFN_ID3D11Device_CreateTexture2D create = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11Device_CreateTexture2D, npt_com_vtable(device),
+      NPT_VTBL_ID3D11Device_CreateTexture2D);
+   HRESULT hr = create(device, &desc, NULL, &staging);
+   snprintf(hr_json, sizeof(hr_json), "%" PRId32, (int32_t)hr);
+   if (NPT_FAILED(hr) || !staging) {
+      status = "failed";
+      step = NPT_FAILED(hr) ? "create_staging" : "create_staging_null";
+      goto report;
+   }
+   /* Creation may itself consume the remaining time. Do not issue a new
+    * copy after the deadline; an already-issued synchronous Map may finish
+    * later and is reported honestly rather than cancelled mid-operation. */
+   strcpy(hr_json, "null");
+   if (!npt_bc6_now(&now)) {
+      status = "failed";
+      step = stop_reason = "clock_failed";
+      goto report;
+   }
+   if (now - s->first_upload_ns >= NPT_BC6_UPLOAD_MAX_NS) {
+      step = "deadline_before_copy";
+      stop_reason = "deadline";
+      goto report;
+   }
+   PFN_ID3D11DeviceContext_CopySubresourceRegion copy = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11DeviceContext_CopySubresourceRegion, npt_com_vtable(imm_ctx),
+      NPT_VTBL_ID3D11DeviceContext_CopySubresourceRegion);
+   s->readbacks++;
+   copy(imm_ctx, (ID3D11Resource *)staging, mip, 0, 0, 0,
+        resource, subresource, NULL);
+   PFN_ID3D11DeviceContext_Map map = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11DeviceContext_Map, npt_com_vtable(imm_ctx),
+      NPT_VTBL_ID3D11DeviceContext_Map);
+   PFN_ID3D11DeviceContext_Unmap unmap = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11DeviceContext_Unmap, npt_com_vtable(imm_ctx),
+      NPT_VTBL_ID3D11DeviceContext_Unmap);
+   D3D11_MAPPED_SUBRESOURCE mapped = {0};
+   hr = map(imm_ctx, (ID3D11Resource *)staging, mip, D3D11_MAP_READ, 0, &mapped);
+   snprintf(hr_json, sizeof(hr_json), "%" PRId32, (int32_t)hr);
+   if (NPT_FAILED(hr)) {
+      status = "failed";
+      step = "map_read";
+      goto report;
+   }
+   if (!mapped.pData || mapped.RowPitch < tight_row ||
+       (uint64_t)(rows - 1) * mapped.RowPitch + tight_row > SIZE_MAX) {
+      status = "failed";
+      step = "mapped_extent";
+   } else {
+      uint32_t actual_reserved;
+      uint64_t actual_hash = npt_bc6_hash_rows(mapped.pData, mapped.RowPitch,
+                                                rows, tight_row, &actual_reserved);
+      snprintf(actual_hash_json, sizeof(actual_hash_json),
+               "\"%016" PRIx64 "\"", actual_hash);
+      snprintf(actual_reserved_json, sizeof(actual_reserved_json),
+               "%u", actual_reserved);
+      for (uint32_t y = 0; y < rows; y++) {
+         const uint8_t *expected = (const uint8_t *)payload + (size_t)y * row_pitch;
+         const uint8_t *actual = (const uint8_t *)mapped.pData + (size_t)y * mapped.RowPitch;
+         for (uint32_t x = 0; x < tight_row; x++) {
+            if (expected[x] == actual[x])
+               continue;
+            if (!mismatch_count)
+               snprintf(first_json, sizeof(first_json),
+                        ",\"first_mismatch_offset\":%u,\"first_expected_byte\":%u,"
+                        "\"first_actual_byte\":%u", y * tight_row + x,
+                        (unsigned)expected[x], (unsigned)actual[x]);
+            mismatch_count++;
+         }
+      }
+      snprintf(mismatch_json, sizeof(mismatch_json), "%u", mismatch_count);
+      s->comparisons++;
+      s->compared_bytes += tightbytes;
+      status = mismatch_count ? "mismatch" : "match";
+      step = "compare";
+   }
+   unmap(imm_ctx, (ID3D11Resource *)staging, mip);
+
+report:
+   if (staging)
+      npt_com_release(staging);
+   if (!strcmp(status, "match"))
+      s->matches++;
+   else if (!strcmp(status, "mismatch"))
+      s->mismatches++;
+   else if (!strcmp(status, "failed"))
+      s->failed++;
+   else
+      s->skipped++;
+   if (!npt_bc6_now(&now))
+      stop_reason = "clock_failed";
+   npt_log("BC6UploadCheck {\"schema\":\"astra-bc6-upload-check-1\","
+           "\"event\":\"BC6UploadCheck\",\"guest_pid\":%u,\"hostpid\":%ld,"
+           "\"client\":\"%s\",\"tag_truncated\":%s,"
+           "\"transport_ctx\":%u,\"resource_id\":\"%016" PRIx64 "\","
+           "\"update_index\":%u,\"subresource\":%u,\"mip\":%u,\"side\":%u,"
+           "\"array_slice\":%u,\"tightbytes\":%u,\"row_pitch\":%u,\"byte_size\":%u,"
+           "\"status\":\"%s\",\"step\":\"%s\",\"hresult\":%s,"
+           "\"mismatched_bytes\":%s,\"expected_fnv1a64\":%s,\"actual_fnv1a64\":%s,"
+           "\"expected_reserved_blocks\":%s,\"actual_reserved_blocks\":%s,"
+           "\"elapsed_ms\":%" PRIu64 "%s}",
+           s->guest_pid, (long)getpid(), s->client,
+           s->tag_truncated ? "true" : "false", ctx->ctx_id, resource_id, s->updates,
+           subresource, mip, side, subresource / 8, tightbytes, row_pitch, byte_size,
+           status, step, hr_json, mismatch_json, expected_hash_json, actual_hash_json,
+           expected_reserved_json, actual_reserved_json,
+           npt_bc6_elapsed_ms(s, now), first_json);
+   if (!stop_reason && s->updates == NPT_BC6_UPLOAD_MAX_UPDATES)
+      stop_reason = "update_cap";
+   if (!stop_reason && s->tight_bytes_budgeted == NPT_BC6_UPLOAD_MAX_BYTES)
+      stop_reason = "byte_cap";
+   if (!stop_reason && s->started && now - s->first_upload_ns >= NPT_BC6_UPLOAD_MAX_NS)
+      stop_reason = "deadline";
+   if (stop_reason)
+      npt_bc6_summary(ctx, stop_reason, now);
+unlock:
+   mtx_unlock(&s->mutex);
+}
diff --git a/src/neptune/npt_bc6_upload_check.h b/src/neptune/npt_bc6_upload_check.h
new file mode 100644
index e69de29bb2d1d6434b8b29ae775ad8c2e48c5391..36c1044cd6e310e0b7f086544f54533e14edbe41
--- /dev/null
+++ b/src/neptune/npt_bc6_upload_check.h
@@ -0,0 +1,55 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT
+ *
+ * Bounded diagnostic for the BC6 source-cube upload, disabled by default.
+ */
+#ifndef NPT_BC6_UPLOAD_CHECK_H
+#define NPT_BC6_UPLOAD_CHECK_H
+
+#include "npt_common.h"
+#include "neptune-protocol/npt_protocol_host_dispatch_types.h"
+
+#define NPT_BC6_UPLOAD_MAX_RESOURCES 128u
+#define NPT_BC6_UPLOAD_MAX_UPDATES 6144u
+#define NPT_BC6_UPLOAD_MAX_BYTES (32u * 1024u * 1024u)
+#define NPT_BC6_UPLOAD_MAX_NS UINT64_C(120000000000)
+
+struct npt_bc6_upload_check_state {
+   /* enabled is immutable after context initialization. All remaining
+    * state and diagnostic D3D calls are protected by mutex. Normal D3D
+    * calls, including the preceding upload, do not take this mutex. */
+   bool enabled;
+   mtx_t mutex;
+   uint32_t guest_pid;
+   const char *client;
+   bool tag_truncated;
+   bool started;
+   bool stopped;
+   bool summary_emitted;
+   uint64_t first_upload_ns;
+   uint64_t resource_ids[NPT_BC6_UPLOAD_MAX_RESOURCES];
+   uint32_t resources;
+   uint32_t updates;
+   uint32_t readbacks;
+   uint32_t comparisons;
+   uint32_t matches;
+   uint32_t mismatches;
+   uint32_t skipped;
+   uint32_t failed;
+   uint64_t tight_bytes_budgeted;
+   uint64_t compared_bytes;
+};
+
+void npt_bc6_upload_check_init(struct npt_context *ctx, size_t debug_len);
+void npt_bc6_upload_check_fini(struct npt_context *ctx);
+
+/* Called immediately after ordinary UpdateSubresource, before the borrowed
+ * payload or recovered device/context references are released. */
+void npt_bc6_upload_check(struct npt_context *ctx, void *resource,
+                          ID3D11Device *device, ID3D11DeviceContext *imm_ctx,
+                          uint64_t resource_id, uint32_t subresource,
+                          uint32_t row_pitch, uint32_t byte_size,
+                          bool has_box, const void *payload);
+
+#endif
