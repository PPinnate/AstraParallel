diff --git a/src/neptune/npt_lighting_shader_export.c b/src/neptune/npt_lighting_shader_export.c
new file mode 100644
index e69de29bb2d1d6434b8b29ae775ad8c2e48c5391..7f260e2c799af86cce9cab2b57d2676fa1068aab
--- /dev/null
+++ b/src/neptune/npt_lighting_shader_export.c
@@ -0,0 +1,137 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT
+ */
+#include "npt_lighting_shader_export.h"
+
+#include "npt_context.h"
+
+#ifdef __APPLE__
+#include <CommonCrypto/CommonDigest.h>
+#include <stdio.h>
+#include <unistd.h>
+
+static const char *const npt_lighting_shader_sha1[] = {
+   "7a998b567e2ef83807a0ab0bb9b327799faad364",
+   "64551beb1560905ae7da9cd563a5ba07f546d293",
+};
+
+/* One bounded emission per selected stage per worker process. The atomic
+ * exchange also handles simultaneous CreateShader ring callers. The
+ * collector independently verifies completeness and the reconstructed SHA1. */
+static atomic_bool npt_lighting_shader_attempted[2] = {false, false};
+
+static uint32_t
+npt_lighting_shader_guest_pid(const char *tag)
+{
+   static const char prefix[] = "nptw pid=";
+   if (!tag || strncmp(tag, prefix, sizeof(prefix) - 1))
+      return 0;
+   const char *p = tag + sizeof(prefix) - 1;
+   if (*p < '0' || *p > '9')
+      return 0;
+   uint32_t pid = 0;
+   do {
+      unsigned digit = (unsigned)(*p++ - '0');
+      if (pid > (UINT32_MAX - digit) / 10)
+         return 0;
+      pid = pid * 10 + digit;
+   } while (*p >= '0' && *p <= '9');
+   return !strncmp(p, " exe=", 5) && p[5] ? pid : 0;
+}
+
+static void
+npt_lighting_shader_log(struct npt_context *ctx, unsigned stage,
+                         const char *sha1, size_t byte_count,
+                         const char *result)
+{
+   /* Keep caller-supplied tags bounded and JSON-safe. They are diagnostic
+    * labels, not independently authenticated process identities. */
+   const char *source = ctx->debug_name ? ctx->debug_name : "";
+   char tag[96];
+   size_t i = 0;
+   for (; i + 1 < sizeof(tag) && source[i]; i++) {
+      unsigned char c = (unsigned char)source[i];
+      tag[i] = c >= 32 && c <= 126 && c != '"' && c != '\\' ? c : '_';
+   }
+   tag[i] = '\0';
+   char pid_json[16] = "null";
+   uint32_t pid = npt_lighting_shader_guest_pid(source);
+   if (pid)
+      snprintf(pid_json, sizeof(pid_json), "%u", pid);
+   npt_log("LightingShaderExport {\"schema\":\"astra-lighting-shader-export-1\","
+           "\"stage\":\"%s\",\"sha1\":\"%s\",\"bytecount\":%zu,"
+           "\"hostpid\":%ld,\"transport_ctx\":%u,\"guest_pid\":%s,"
+           "\"tag\":\"%s\",\"tag_log_truncated\":%s,"
+           "\"result\":\"%s\"}",
+           stage == NPT_LIGHTING_SHADER_VS ? "vs" : "ps", sha1, byte_count,
+           (long)getpid(), ctx->ctx_id, pid_json, tag,
+           source[i] ? "true" : "false", result);
+}
+#endif
+
+void
+npt_lighting_shader_export(struct npt_context *ctx,
+                            enum npt_lighting_shader_stage stage,
+                            const void *bytecode, size_t byte_count)
+{
+#ifdef __APPLE__
+   const char *enabled = getenv("ASTRA_LIGHTING_SHADER_EXPORT");
+   if (!enabled || strcmp(enabled, "1") || !ctx ||
+       (stage != NPT_LIGHTING_SHADER_VS && stage != NPT_LIGHTING_SHADER_PS) ||
+       !bytecode || byte_count < 32 || byte_count > 65536u)
+      return;
+   if (atomic_load_explicit(&npt_lighting_shader_attempted[stage], memory_order_relaxed))
+      return;
+   if (memcmp(bytecode, "DXBC", 4))
+      return;
+
+   unsigned char digest[CC_SHA1_DIGEST_LENGTH];
+   /* SHA1 is the externally supplied shader identifier, not a security or
+    * trust primitive. Hash the complete payload, not the DXBC header hash. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+   unsigned char *hash_result = CC_SHA1(bytecode, (CC_LONG)byte_count, digest);
+#pragma clang diagnostic pop
+   if (!hash_result)
+      return;
+   static const char hex[] = "0123456789abcdef";
+   char sha1[CC_SHA1_DIGEST_LENGTH * 2 + 1];
+   for (unsigned i = 0; i < CC_SHA1_DIGEST_LENGTH; i++) {
+      sha1[i * 2] = hex[digest[i] >> 4];
+      sha1[i * 2 + 1] = hex[digest[i] & 15];
+   }
+   sha1[sizeof(sha1) - 1] = '\0';
+   if (strcmp(sha1, npt_lighting_shader_sha1[stage]))
+      return;
+   if (atomic_exchange_explicit(&npt_lighting_shader_attempted[stage], true,
+                                memory_order_relaxed))
+      return;
+
+   /* Match the existing private runtime-log collector's bounded format.
+    * Each line is independently identified by full SHA1 and byte offset,
+    * so VS/PS records may interleave without confusing reconstruction. */
+   npt_log("ASTRA_SHADER_DIAG_BEGIN sha1=%s bytes=%zu", sha1, byte_count);
+   for (size_t offset = 0; offset < byte_count; offset += 192) {
+      size_t count = byte_count - offset;
+      if (count > 192)
+         count = 192;
+      char chunk_hex[192 * 2 + 1];
+      const uint8_t *chunk = (const uint8_t *)bytecode + offset;
+      for (size_t i = 0; i < count; i++) {
+         chunk_hex[i * 2] = hex[chunk[i] >> 4];
+         chunk_hex[i * 2 + 1] = hex[chunk[i] & 15];
+      }
+      chunk_hex[count * 2] = '\0';
+      npt_log("ASTRA_SHADER_DIAG_DATA sha1=%s offset=%zu hex=%s", sha1, offset, chunk_hex);
+   }
+   npt_log("ASTRA_SHADER_DIAG_END sha1=%s", sha1);
+   npt_lighting_shader_log(ctx, stage, sha1, byte_count, "logged_to_runtime");
+#else
+   /* This local opt-in uses the macOS system SHA1 implementation only. */
+   (void)ctx;
+   (void)stage;
+   (void)bytecode;
+   (void)byte_count;
+#endif
+}
