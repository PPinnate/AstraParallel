+/* The guest serializes CreateTexture2D initial data as RESOURCE_UPDATE after
+ * creation. UpdateSubresource is not a valid upload API for depth/stencil
+ * textures and skips DXMT's packed D24 conversion. Initialize a CPU staging
+ * texture and copy the complete subresource through the normal D3D11 path.
+ * Keep all payload validation here before passing guest bytes to the backend.
+ */
+static bool
+npt_upload_depth_initial_data(void *resource, ID3D11Device *device,
+                              ID3D11DeviceContext *imm_ctx,
+                              uint32_t subresource, uint32_t row_pitch,
+                              uint32_t byte_size, bool has_box,
+                              const void *payload)
+{
+   D3D11_RESOURCE_DIMENSION dimension = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+   PFN_ID3D11Resource_GetType get_type = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11Resource_GetType, npt_com_vtable(resource),
+      NPT_VTBL_ID3D11Resource_GetType);
+   get_type(resource, &dimension);
+   if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+      return false;
+   D3D11_TEXTURE2D_DESC desc;
+   PFN_ID3D11Texture2D_GetDesc get_desc = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11Texture2D_GetDesc, npt_com_vtable(resource),
+      NPT_VTBL_ID3D11Texture2D_GetDesc);
+   get_desc(resource, &desc);
+   if (!(desc.BindFlags & D3D11_BIND_DEPTH_STENCIL))
+      return false;
+
+   uint32_t bytes_per_pixel;
+   switch (desc.Format) {
+   case DXGI_FORMAT_R16_TYPELESS:
+   case DXGI_FORMAT_D16_UNORM:
+      bytes_per_pixel = 2;
+      break;
+   case DXGI_FORMAT_R32G8X24_TYPELESS:
+   case DXGI_FORMAT_D32_FLOAT_S8X24_UINT:
+      bytes_per_pixel = 8;
+      break;
+   case DXGI_FORMAT_R32_TYPELESS:
+   case DXGI_FORMAT_D32_FLOAT:
+   case DXGI_FORMAT_R24G8_TYPELESS:
+   case DXGI_FORMAT_D24_UNORM_S8_UINT:
+      bytes_per_pixel = 4;
+      break;
+   default:
+      return false;
+   }
+   if (has_box || !payload || !desc.MipLevels ||
+       subresource >= (uint64_t)desc.MipLevels * desc.ArraySize ||
+       desc.SampleDesc.Count != 1) {
+      npt_log("depth initial upload rejected: invalid subresource or extent");
+      return true;
+   }
+   uint32_t mip = subresource % desc.MipLevels;
+   if (mip >= 32)
+      return true;
+   desc.Width = desc.Width >> mip ? desc.Width >> mip : 1;
+   desc.Height = desc.Height >> mip ? desc.Height >> mip : 1;
+   uint64_t row_bytes = (uint64_t)desc.Width * bytes_per_pixel;
+   uint64_t required = (uint64_t)(desc.Height - 1) * row_pitch + row_bytes;
+   if (row_pitch < row_bytes || required > byte_size) {
+      npt_log("depth initial upload rejected: payload is smaller than its extent");
+      return true;
+   }
+   desc.MipLevels = desc.ArraySize = 1;
+   desc.Usage = D3D11_USAGE_STAGING;
+   desc.BindFlags = desc.MiscFlags = 0;
+   desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+   D3D11_SUBRESOURCE_DATA initial = {payload, row_pitch, 0};
+   ID3D11Texture2D *staging = NULL;
+   PFN_ID3D11Device_CreateTexture2D create = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11Device_CreateTexture2D, npt_com_vtable(device),
+      NPT_VTBL_ID3D11Device_CreateTexture2D);
+   HRESULT hr = create(device, &desc, &initial, &staging);
+   if (NPT_FAILED(hr) || !staging) {
+      npt_log("depth initial upload staging failed: 0x%08x", (unsigned)hr);
+      return true;
+   }
+   PFN_ID3D11DeviceContext_CopySubresourceRegion copy = NPT_COM_VTBL_FUNC(
+      PFN_ID3D11DeviceContext_CopySubresourceRegion, npt_com_vtable(imm_ctx),
+      NPT_VTBL_ID3D11DeviceContext_CopySubresourceRegion);
+   copy(imm_ctx, resource, subresource, 0, 0, 0,
+        (ID3D11Resource *)staging, 0, NULL);
+   npt_com_release(staging);
+   static atomic_uint reported = 0;
+   if (atomic_fetch_add_explicit(&reported, 1, memory_order_relaxed) < 16)
+      npt_log("AstraDepthInitialUpload format=%u width=%u height=%u subresource=%u",
+              (unsigned)desc.Format, desc.Width, desc.Height, subresource);
+   return true;
+}
 
