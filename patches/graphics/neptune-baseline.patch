+++ b/src/virtio/neptune/astra_gpu_trace.h
@@ -0,0 +1,271 @@
+#ifndef ASTRA_GPU_TRACE_H
+#define ASTRA_GPU_TRACE_H
+#include <stddef.h>
+#include <stdint.h>
+/* Local diagnostic records: no buffers, shaders, inputs, or account data. */
+void astra_gpu_trace(const char *kind, const char *text);
+void astra_gpu_tracef(const char *kind, const char *format, ...);
+void astra_gpu_trace_filtered(const char *kind, const char *text);
+void astra_npt_log(const char *format, ...);
+
+/* ASCII-only basename; never publishes a directory or an untrusted log field. */
+static inline void astra_gpu_sanitized_basename(char *out, size_t capacity,
+                                               const char *image)
+{
+    if (!out || !capacity) return;
+    const char *base = image ? image : "unknown";
+    for (const char *p = base; *p; ++p)
+        if (*p == '\\' || *p == '/') base = p + 1;
+    if (!*base) base = "unknown";
+    size_t i = 0;
+    for (; base[i] && i + 1 < capacity; ++i) {
+        unsigned char c = (unsigned char)base[i];
+        out[i] = ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                  (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-')
+                     ? (char)c : '_';
+    }
+    out[i] = 0;
+}
+
+enum astra_present_method {
+    ASTRA_PRESENT_METHOD_PRESENT = 0,
+    ASTRA_PRESENT_METHOD_PRESENT1 = 1
+};
+
+enum astra_present_drop {
+    ASTRA_PRESENT_DROP_NO_KERNEL_CONTEXT = 1u << 0,
+    ASTRA_PRESENT_DROP_NO_CALLBACK = 1u << 1,
+    ASTRA_PRESENT_DROP_NO_ALLOCATION = 1u << 2
+};
+
+struct astra_present_metadata {
+    uint32_t src_ctx, dst_ctx;
+    uint64_t src_object, dst_object;
+    uint32_t method, submitted, drop_mask;
+    uint32_t primary, shared, width, height, format;
+    uint32_t src_allocation, dst_allocation;
+    int32_t result_hr;
+};
+
+/* Only cached scalar metadata; call after presentation locks are released. */
+void astra_gpu_trace_present(const struct astra_present_metadata *metadata);
+
+enum astra_bc6_source_origin {
+    ASTRA_BC6_SOURCE_INITIAL = 0,
+    ASTRA_BC6_SOURCE_UPDATE = 1
+};
+
+/* Cached descriptor scalars identify the single selected source shape.
+ * Only tight-row hashes/counts are emitted; source bytes are never logged. */
+struct astra_bc6_source_metadata {
+    uint32_t ctx;
+    uint64_t resource_id;
+    uint32_t width, height, depth, mip_levels, array_size;
+    uint32_t format, sample_count, usage;
+    uint32_t subresource, row_pitch, copy_size, origin;
+};
+
+/* Neptune override-entry checkpoint, not the original application/DDI entry.
+ * The caller retains only these scalar fingerprints on its own stack until
+ * the host create assigns an opaque resource ID. No source pointer or payload
+ * is retained here; the timestamp is taken immediately before each hash. */
+#define ASTRA_BC6_ENTRY_SUBRESOURCES 48u
+enum astra_bc6_map_match {
+    ASTRA_BC6_MAP_ACTIVE = 1, ASTRA_BC6_MAP_RETIRED,
+    ASTRA_BC6_MAP_AMBIGUOUS, ASTRA_BC6_MAP_NO_MATCH,
+    ASTRA_BC6_MAP_UNAVAILABLE
+};
+enum astra_bc6_map_reason {
+    ASTRA_BC6_MAP_OK = 0, ASTRA_BC6_MAP_NOT_STARTED,
+    ASTRA_BC6_MAP_HISTORY_LOSS, ASTRA_BC6_MAP_TIME_LIMIT,
+    ASTRA_BC6_MAP_TRANSITION_LIMIT, ASTRA_BC6_MAP_QUERY_LIMIT,
+    ASTRA_BC6_MAP_INVALID_QUERY
+};
+enum astra_bc6_map_kind {
+    ASTRA_BC6_MAP_BUFFER = 1, ASTRA_BC6_MAP_TEXTURE = 2
+};
+/* No addresses or retained interfaces in a result: only scalar provenance.
+ * Registry addresses remain private to the logger and are never dereferenced. */
+struct astra_bc6_map_origin {
+    uint32_t match_state, tracking_complete, reason, match_count;
+    uint32_t query_bytes, transitions, queries, evictions, overwrites;
+    uint32_t expired, dropped, active, retired, probe_maps;
+    uint32_t source_ctx, source_subresource, source_kind, source_map_type;
+    uint32_t source_scope, source_bytes, relative_offset;
+    uint32_t source_row_pitch, source_depth_pitch;
+    uint64_t map_age_ms, retired_age_ms, source_generation, source_resource_id;
+};
+struct astra_bc6_entry_fingerprint {
+    uint64_t fnv1a64;
+    uint32_t reserved_blocks, row_pitch, copy_size, tightbytes, valid;
+    uint16_t year, month, day, hour, minute, second, millisecond;
+    struct astra_bc6_map_origin map_origin;
+};
+
+struct astra_bc6_entry_snapshot {
+    uint32_t active, complete, client_kind, captured_rows;
+    struct astra_bc6_entry_fingerprint rows[ASTRA_BC6_ENTRY_SUBRESOURCES];
+};
+
+/* Original Triton DDI input and the actual converted Texture2D descriptor.
+ * Stack-only scalar observation: no source pointers, payload, or COM ownership. */
+struct astra_bc6_ddi_raw_desc {
+    uint32_t dimension, format, usage, map_flags, mip_levels, array_size;
+    uint32_t sample_count, sample_quality, byte_stride, bind_flags, misc_flags;
+    uint32_t initial_data_present, mip_info_present, primary_desc_present;
+    uint32_t texel_width, texel_height, texel_depth;
+    uint32_t physical_width, physical_height, physical_depth;
+};
+struct astra_bc6_ddi_converted_desc {
+    uint32_t width, height, mip_levels, array_size, format;
+    uint32_t sample_count, sample_quality, usage;
+    uint32_t bind_flags, cpu_access_flags, misc_flags, initial_data_present;
+};
+struct astra_bc6_ddi_desc_snapshot {
+    struct astra_bc6_ddi_raw_desc raw;
+    struct astra_bc6_ddi_converted_desc converted;
+    uint32_t admitted, converted_valid, client_kind, seq;
+    uint16_t year, month, day, hour, minute, second, millisecond;
+};
+
+/* Original-DDI initial-data checkpoint, independent of the later entry hash.
+ * Only scalar fingerprints survive the bounded capture; no Map query result,
+ * source pointer, payload copy, or resource reference is retained. */
+#define ASTRA_BC6_DDI_SOURCE_SUBRESOURCES 48u
+struct astra_bc6_ddi_source_fingerprint {
+    uint64_t fnv1a64;
+    uint32_t reserved_blocks, row_pitch, copy_size, tightbytes, valid;
+    uint16_t year, month, day, hour, minute, second, millisecond;
+};
+struct astra_bc6_ddi_source_snapshot {
+    uint32_t active, complete, client_kind, captured_rows;
+    struct astra_bc6_ddi_source_fingerprint rows[ASTRA_BC6_DDI_SOURCE_SUBRESOURCES];
+};
+
+#ifdef _WIN32
+/* Successful begin reserves a whole batch and holds only this observer's lock.
+ * The caller must end its bounded capture before any ordinary Create work. */
+int astra_gpu_trace_bc6_ddi_source_begin(struct astra_bc6_ddi_source_snapshot *snapshot);
+int astra_gpu_trace_bc6_ddi_source_hash(
+    struct astra_bc6_ddi_source_snapshot *snapshot, uint32_t subresource,
+    uint32_t row_pitch, const void *source);
+void astra_gpu_trace_bc6_ddi_source_end(struct astra_bc6_ddi_source_snapshot *snapshot);
+void astra_gpu_trace_bc6_ddi_source_emit(
+    const struct astra_bc6_ddi_source_snapshot *snapshot,
+    uint32_t ctx, uint64_t resource_id);
+int astra_gpu_trace_bc6_ddi_desc_allowed(void);
+void astra_gpu_trace_bc6_ddi_desc_begin(struct astra_bc6_ddi_desc_snapshot *snapshot);
+void astra_gpu_trace_bc6_ddi_desc_emit(
+    const struct astra_bc6_ddi_desc_snapshot *snapshot,
+    uint32_t ctx, uint64_t resource_id);
+/* Reads cached NPT texture identity only; never selects or touches a ring. */
+int astra_gpu_trace_bc6_ddi_resource_identity(
+    void *resource, uint32_t *ctx, uint64_t *resource_id);
+void astra_gpu_trace_map_return(
+    uint32_t ctx, uint64_t resource_id, uint32_t subresource,
+    uint32_t map_type, const void *data, uint32_t bytes, uint32_t source_kind,
+    uint32_t row_pitch, uint32_t depth_pitch);
+void astra_gpu_trace_map_unmap(
+    uint32_t ctx, uint64_t resource_id, uint32_t subresource,
+    const void *data, uint32_t bytes);
+void astra_gpu_trace_map_storage_release(const void *data, uint32_t bytes);
+void astra_gpu_trace_map_probe_begin(void);
+void astra_gpu_trace_map_probe_end(void);
+void astra_gpu_trace_bc6_source(const struct astra_bc6_source_metadata *metadata,
+                               const void *source);
+/* A successful begin holds only the independent diagnostic lock. The caller
+ * must call end after its48 hash calls, before any COM/host/ring interaction. */
+int astra_gpu_trace_bc6_entry_begin(
+    struct astra_bc6_entry_snapshot *snapshot,
+    const struct astra_bc6_source_metadata *shape);
+void astra_gpu_trace_bc6_entry_hash(
+    struct astra_bc6_entry_snapshot *snapshot, uint32_t subresource,
+    uint32_t row_pitch, const void *source);
+void astra_gpu_trace_bc6_entry_end(struct astra_bc6_entry_snapshot *snapshot);
+void astra_gpu_trace_bc6_entry_emit(
+    const struct astra_bc6_entry_snapshot *snapshot,
+    uint32_t ctx, uint64_t resource_id);
+#else
+static inline int astra_gpu_trace_bc6_ddi_source_begin(
+    struct astra_bc6_ddi_source_snapshot *snapshot)
+{ if (snapshot) snapshot->active = snapshot->complete = 0; return 0; }
+static inline int astra_gpu_trace_bc6_ddi_source_hash(
+    struct astra_bc6_ddi_source_snapshot *snapshot, uint32_t subresource,
+    uint32_t row_pitch, const void *source)
+{ (void)snapshot; (void)subresource; (void)row_pitch; (void)source; return 0; }
+static inline void astra_gpu_trace_bc6_ddi_source_end(
+    struct astra_bc6_ddi_source_snapshot *snapshot)
+{ (void)snapshot; }
+static inline void astra_gpu_trace_bc6_ddi_source_emit(
+    const struct astra_bc6_ddi_source_snapshot *snapshot,
+    uint32_t ctx, uint64_t resource_id)
+{ (void)snapshot; (void)ctx; (void)resource_id; }
+static inline int astra_gpu_trace_bc6_ddi_desc_allowed(void) { return 0; }
+static inline void astra_gpu_trace_bc6_ddi_desc_begin(
+    struct astra_bc6_ddi_desc_snapshot *snapshot)
+{ if (snapshot) snapshot->admitted = 0; }
+static inline void astra_gpu_trace_bc6_ddi_desc_emit(
+    const struct astra_bc6_ddi_desc_snapshot *snapshot,
+    uint32_t ctx, uint64_t resource_id)
+{ (void)snapshot; (void)ctx; (void)resource_id; }
+static inline int astra_gpu_trace_bc6_ddi_resource_identity(
+    void *resource, uint32_t *ctx, uint64_t *resource_id)
+{
+    (void)resource;
+    if (ctx) *ctx = 0;
+    if (resource_id) *resource_id = 0;
+    return 0;
+}
+static inline void astra_gpu_trace_map_return(
+    uint32_t ctx, uint64_t resource_id, uint32_t subresource,
+    uint32_t map_type, const void *data, uint32_t bytes, uint32_t source_kind,
+    uint32_t row_pitch, uint32_t depth_pitch)
+{
+    (void)ctx; (void)resource_id; (void)subresource; (void)map_type;
+    (void)data; (void)bytes; (void)source_kind; (void)row_pitch; (void)depth_pitch;
+}
+static inline void astra_gpu_trace_map_unmap(
+    uint32_t ctx, uint64_t resource_id, uint32_t subresource,
+    const void *data, uint32_t bytes)
+{
+    (void)ctx; (void)resource_id; (void)subresource; (void)data; (void)bytes;
+}
+static inline void astra_gpu_trace_map_storage_release(const void *data, uint32_t bytes)
+{ (void)data; (void)bytes; }
+static inline void astra_gpu_trace_map_probe_begin(void) {}
+static inline void astra_gpu_trace_map_probe_end(void) {}
+static inline void
+astra_gpu_trace_bc6_source(const struct astra_bc6_source_metadata *metadata,
+                          const void *source)
+{
+    (void)metadata;
+    (void)source;
+}
+static inline int
+astra_gpu_trace_bc6_entry_begin(struct astra_bc6_entry_snapshot *snapshot,
+                               const struct astra_bc6_source_metadata *shape)
+{
+    (void)shape;
+    if (snapshot) snapshot->active = snapshot->complete = 0;
+    return 0;
+}
+static inline void
+astra_gpu_trace_bc6_entry_hash(struct astra_bc6_entry_snapshot *snapshot,
+                              uint32_t subresource, uint32_t row_pitch,
+                              const void *source)
+{
+    (void)snapshot; (void)subresource; (void)row_pitch; (void)source;
+}
+static inline void
+astra_gpu_trace_bc6_entry_end(struct astra_bc6_entry_snapshot *snapshot)
+{
+    (void)snapshot;
+}
+static inline void
+astra_gpu_trace_bc6_entry_emit(const struct astra_bc6_entry_snapshot *snapshot,
+                              uint32_t ctx, uint64_t resource_id)
+{
+    (void)snapshot; (void)ctx; (void)resource_id;
+}
+#endif
+#endif
