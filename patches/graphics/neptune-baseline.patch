+static HRESULT
+ctx_Map_staging_texture(void *self, struct npt_d3d11_texture *t,
+                        UINT Subresource, D3D11_MAP MapType, UINT MapFlags,
+                        D3D11_MAPPED_SUBRESOURCE *out)
+{
+   memset(out, 0, sizeof(*out));
+   struct npt_d3d11_texture_staging_map *map = NULL;
+   HRESULT hr = npt_d3d11_texture_prepare_staging_map(t, Subresource, &map);
+   if (NPT_FAILED(hr))
+      return hr;
+   const uint64_t context_id = ((struct npt_com_base *)self)->base.id;
+   const uint64_t resource_id = ((struct npt_com_base *)t)->base.id;
+   const uint32_t res_id = npt_d3d_map_ring_slot_res_id(&map->storage, 0);
+   const uint32_t offset = npt_d3d_map_ring_slot_offset(&map->storage, 0);
+   const uint32_t capacity = map->storage.aligned_slot_size;
+   uint32_t row_pitch = 0, depth_pitch = 0;
+   hr = npt_dispatch_resource_map(
+      npt_com_self_ring(self), context_id, resource_id, Subresource,
+      npt_d3d11_map_to_access_flags(MapType), MapFlags, res_id,
+      capacity, map->block_rows, map->depth, offset,
+      &row_pitch, &depth_pitch);
+   if (NPT_FAILED(hr))
+      return hr;
+   const uint64_t size = (uint64_t)row_pitch * map->block_rows * map->depth;
+   if (!size || size > capacity) {
+      /* Balance the successful host Map before rejecting its layout. */
+      npt_dispatch_resource_unmap(npt_com_self_ring(self), context_id,
+         resource_id, Subresource, res_id, capacity, offset, 0);
+      return NPT_E_FAIL;
+   }
+   map->byte_size = (uint32_t)size;
+   map->mapped = true;
+   out->pData = npt_d3d_map_ring_slot_ptr(&map->storage, 0);
+   out->RowPitch = row_pitch;
+   out->DepthPitch = depth_pitch;
+   trace_map_result(self, t, Subresource, MapType, out,
+                     map->byte_size, ASTRA_BC6_MAP_TEXTURE);
+   return NPT_S_OK;
+}
+
+static void
+ctx_Unmap_staging_texture(void *self, struct npt_d3d11_texture *t,
+                          UINT Subresource)
+{
+   struct npt_d3d11_texture_staging_map *map =
+      npt_d3d11_texture_find_staging_map(t, Subresource);
+   if (!map || !map->mapped)
+      return;
+   trace_actual_unmap(self, t, Subresource,
+      npt_d3d_map_ring_slot_ptr(&map->storage, 0), map->byte_size);
+   npt_dispatch_resource_unmap(
+      npt_com_self_ring(self), ((struct npt_com_base *)self)->base.id,
+      ((struct npt_com_base *)t)->base.id, Subresource,
+      npt_d3d_map_ring_slot_res_id(&map->storage, 0), map->byte_size,
+      npt_d3d_map_ring_slot_offset(&map->storage, 0), 0);
+   map->mapped = false;
+   map->byte_size = 0;
 }
 
