+/* Scalar observers only. The ordinary Map/Unmap return values, outputs,
+ * resource ownership, and transport calls remain unchanged. */
+static void
+trace_map_result(void *self, void *resource, UINT subresource, D3D11_MAP map_type,
+                 const D3D11_MAPPED_SUBRESOURCE *mapped, uint32_t bytes,
+                 uint32_t source_kind)
+{
+   struct npt_device *dev = npt_com_self_device(self);
+   astra_gpu_trace_map_return(
+      dev && dev->renderer ? dev->renderer->info.virtio_ctx_id : 0,
+      ((struct npt_com_base *)resource)->base.id, subresource,
+      (uint32_t)map_type, mapped->pData, bytes, source_kind,
+      mapped->RowPitch, mapped->DepthPitch);
+}
+
+static void
+trace_actual_unmap(void *self, void *resource, UINT subresource,
+                   const void *data, uint32_t bytes)
+{
+   struct npt_device *dev = npt_com_self_device(self);
+   astra_gpu_trace_map_unmap(
+      dev && dev->renderer ? dev->renderer->info.virtio_ctx_id : 0,
+      ((struct npt_com_base *)resource)->base.id, subresource, data, bytes);
+}
