+   assert(res->transient_pin_count > 0);
+   res->transient_pin_count--;
+   const bool free_now = res->zombie && res->transient_pin_count == 0 &&
+                         res->heap_import_count == 0;
+   mtx_unlock(&ctx->resource_mutex);
+
+   if (free_now)
+      npt_resource_free(res);
 }
 
