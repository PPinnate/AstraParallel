+namespace {
+
+// Freeze the opt-in at native-image initialization, before any public resource
+// creation calls. The file is polled elsewhere; no file I/O occurs here.
+const bool graph_resource_capture_enabled = [] {
+  const char *control = std::getenv("ASTRA_RENDER_GRAPH_CONTROL");
+  return control && control[0] != '\0';
+}();
+
+std::atomic<uint64_t> graph_resource_last_uid{0};
+
+} // namespace
+
+bool
+GraphResourceCaptureEnabled() {
+  return graph_resource_capture_enabled;
+}
+
+uint64_t
+AllocateGraphResourceUID() {
+  if (!graph_resource_capture_enabled)
+    return 0;
+
+  // Saturate rather than wrapping into a previously issued logical identity.
+  // Relaxed ordering is sufficient: this counter conveys uniqueness only.
+  uint64_t previous = graph_resource_last_uid.load(std::memory_order_relaxed);
+  while (previous != std::numeric_limits<uint64_t>::max()) {
+    if (graph_resource_last_uid.compare_exchange_weak(
+          previous, previous + 1, std::memory_order_relaxed, std::memory_order_relaxed))
+      return previous + 1;
+  }
+  return 0;
+}
+
 } // namespace dxmt
+
+// Optional native bridge. A non-null pointer must be a live DXMT
+// ID3D11Resource interface owned by the caller for the duration of this call.
+// The scalar snapshot neither extends that lifetime nor changes the wire ABI.
+extern "C" __attribute__((visibility("default"))) uint64_t
+AstraDebugTagResource(void *d3d11_resource, uint32_t transport_ctx, uint64_t proxy_object, uint64_t blob_id) {
+  if (!d3d11_resource || !dxmt::GraphResourceCaptureEnabled())
+    return 0;
+
+  auto *resource = dxmt::GetResourceCommon(static_cast<ID3D11Resource *>(d3d11_resource));
+  const uint64_t uid = resource->graphUID();
+  if (uid)
+    resource->setGraphTags(transport_ctx, proxy_object, blob_id);
+  return uid;
+}
