+inline std::string
+AstraGraphTrace::serialize(Burst &data) {
+  std::string out;
+  out.reserve(size_t(data.json_budget));
+  auto number = [&](auto value) {
+    char buffer[32];
+    const auto result = std::to_chars(buffer, buffer + sizeof(buffer), value);
+    out.append(buffer, size_t(result.ptr - buffer));
+  };
+  auto boolean = [&](bool value) { out += value ? "true" : "false"; };
+  auto utc = [&](uint64_t ns) {
+    const time_t seconds = time_t(ns / 1000000000);
+    struct tm broken{};
+    char date[32]{}, result[64]{};
+    if (::gmtime_r(&seconds, &broken)) {
+      ::strftime(date, sizeof(date), "%Y-%m-%dT%H:%M:%S", &broken);
+      std::snprintf(result, sizeof(result), "%s.%09uZ", date, unsigned(ns % 1000000000));
+    }
+    out += '"'; out += result; out += '"';
+  };
+  auto minlod = [&](const AstraGraphMinLODCounts &counts) {
+    out += "{\"total\":"; number(counts.total); out += ",\"zero\":"; number(counts.zero);
+    out += ",\"positive\":"; number(counts.positive); out += ",\"other\":"; number(counts.other); out += '}';
+  };
