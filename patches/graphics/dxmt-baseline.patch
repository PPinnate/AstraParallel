+template<class TYPE,class ARG_TYPE>
+void CDXList<TYPE,ARG_TYPE>::FreeNode(CNode *pNode) {
+  DXDestructElements(&pNode->data,1);
+  pNode->pNext = m_pNodeFree;
+  m_pNodeFree = pNode;
+  m_nCount--;
+  _ASSERT(m_nCount >= 0);
+}
