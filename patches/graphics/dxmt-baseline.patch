element","element_count","byte_offset","byte_size","flags","first_w_slice","w_size","buffer_byte_bounds_known","normalization_incomplete"],"view_kinds":{"1":"SRV","2":"UAV","3":"RTV","4":"DSV"},"shader":["stage","constant_buffer_mask","sampler_mask","srv_mask_lo","srv_mask_hi","uav_mask","ps_valid_render_targets"],"sampler":["filter","address_u","address_v","address_w","mip_lod_bias_bits","max_anisotropy","comparison_func","border_r_bits","border_g_bits","border_b_bits","border_a_bits","min_lod_bits","max_lod_bits"],"command":["sequence","delta_mono_ns","kind","pipeline_kind","flags","source_subresource","destination_subresource","dst_x","dst_y","dst_z","has_box","box_left","box_top","box_front","box_right","box_bottom","box_back","has_rect","rect_left","rect_top","rect_right","rect_bottom"],"edge":["command_sequence","role","resource_uid","definition_id","stage","slot","subresource","byte_offset","byte_size","flags_or_stride_or_index_format","flush_segment"],"stages":{"0":"VS","1":"PS","2":"GS","3":"HS","4":"DS","5":"CS"},"edge_roles":{"1":"declared_srv_read","2":"declared_constant_buffer_window_read","3":"sampler_binding","4":"shader_binding","5":"vertex_buffer_read","6":"index_buffer_read","7":"indirect_args_read","8":"rtv_read_write","9":"dsv_read_write","10":"uav_read_write","11":"stream_output_read_write","12":"copy_read","13":"copy_write_preserve_prior","14":"view_operation_read_write","15":"external_write_preserve_prior","16":"declared_binding_missing"},"unknown_u32":4294967295},"game_exported_output_candidates":[)";
+  bool comma = false;
+  for (uint32_t i = 0; i < data.definition_count; ++i) {
+    const auto &entry = data.definitions[i];
+    if (entry.kind != ResourceDef || !entry.values[18])
+      continue;
+    if (comma) out += ',';
+    comma = true; number(entry.values[0]);
+  }
+  out += "],\"definitions\":[";
+  static constexpr char hex[] = "0123456789abcdef";
+  for (uint32_t i = 0; i < data.definition_count; ++i) {
+    if (i) out += ',';
+    const auto &entry = data.definitions[i];
+    out += '['; number(i + 1); out += ','; number(entry.kind); out += ",[";
+    for (uint32_t j = 0; j < entry.count; ++j) {
+      if (j) out += ',';
