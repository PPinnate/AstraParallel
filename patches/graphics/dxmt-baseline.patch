+  CNode *pOldNode = m_pNodeHead;
+  TYPE returnValue = pOldNode->data;
+  m_pNodeHead = pOldNode->pNext;
+  if(m_pNodeHead!=NULL) m_pNodeHead->pPrev = NULL;
+  else m_pNodeTail = NULL;
+  FreeNode(pOldNode);
