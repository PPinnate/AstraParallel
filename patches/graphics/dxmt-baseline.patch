+  number(data.pid); out += ",\"context_uid\":"; number(data.context);
+  out += ",\"session\":"; number(data.session); out += ",\"nonce\":"; number(data.nonce);
+  out += ",\"start_utc\":"; utc(data.start_utc); out += ",\"end_observed_utc\":"; utc(data.end_utc);
+  out += ",\"start_mono_ns\":"; number(data.start_mono);
+  out += ",\"end_observed_mono_ns\":"; number(data.end_mono);
+  out += ",\"capture_window_end_mono_ns\":";
+  number(std::min(data.end_mono, data.start_mono + kDurationNS));
+  out += R"(,"timing":"producer_and_flush_boundary_checks; expired_window_closes_at_next_hook_or_shutdown","caps":{"duration_ms":500,"commands":8192,"edges":32768,"definitions_total":4096,"bytes":8388608},"commands_include_markers":true,"counts":{"commands":)";
+  number(data.command_count); out += ",\"edges\":"; number(data.edge_count);
+  out += ",\"definitions_total\":"; number(data.definition_count);
+  out += ",\"flush_segments\":"; number(data.segments);
+  out += ",\"preallocated_storage_bytes\":"; number(sizeof(Burst));
+  out += ",\"json_budget_bytes\":"; number(data.json_budget);
+  out += "},\"truncated\":"; boolean(data.truncated);
+  out += ",\"incomplete\":"; boolean(data.incomplete);
+  out += ",\"texture_only\":"; boolean(data.texture_only);
+  out += ",\"buffers_unobserved\":"; boolean(data.texture_only);
+  out += ",\"omitted_counts\":{\"buffer_commands\":"; number(data.omitted_buffer_commands);
+  out += ",\"buffer_bindings\":"; number(data.omitted_buffer_bindings);
+  out += ",\"buffer_definition_attempts\":"; number(data.omitted_buffer_definition_attempts);
+  out += ",\"no_texture_output_commands\":"; number(data.omitted_no_texture_output_commands);
+  out += ",\"tracking_markers\":"; number(data.omitted_tracking_markers); out += '}';
+  out += R"(,"omitted_counts_scope":"observed_intentional_omissions_not_unique_resources","texture_only_policy":"omit_buffer_provenance_and_pipeline_commands_without_effective_texture_outputs","pipeline_flag_bits":{"0":"compute","1":"rasterization_enabled","2":"depth_stencil_enabled_while_rasterizing","8_to_15":"effective_declared_ps_rtv_mask","16":"dual_source_blending"},"effective_attachment_scope":"rasterization_gate_matches_pipeline_description; RTVs_require_effective_PS_declared_target_bit; DSV_requires_enabled_depth_stencil; actual_GPU_writes_unproven")";
+  out += ",\"predicate_bound_observed\":"; boolean(data.predicate_seen);
+  out += ",\"ordinary_gs_bound_effects_unexpanded\":"; boolean(data.ordinary_gs_bound);
+  out += R"(,"pipeline_stage_selection":{"compute":"CS","1":"VS_plus_effective_PS","2":"VS_HS_DS_plus_effective_PS","3":"VS_GS_plus_effective_PS","unknown_graphics_kind":"VS_PS_only_and_incomplete","uav_mask":"union_of_effective_active_shader_declarations; PS_excluded_without_rasterization; graphics_stage_unknown_on_shared_OM_UAV_edges"})";
+  out += ",\"closure\":\""; out += data.closure;
+  out += "\",\"dropped_records_lower_bound\":{\"commands\":"; number(data.dropped_commands);
+  out += ",\"edges\":"; number(data.dropped_edges); out += ",\"definitions\":";
+  number(data.dropped_definitions);
+  out += R"(},"dropped_counts_scope":"observed_rejected_appends","unrecorded_after_stop":"unknown")";
