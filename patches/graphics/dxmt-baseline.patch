+// Conservatively recognize literal NaNs whose value is identical at every
+// vertex. Never infer through arithmetic, conditional writes, indexed outputs,
+// subroutines, or early returns. Other shader data remains untouched.
+static void collect_vertex_constant_nans(CShaderToken *code,
+                                         uint32_t values[32][4]) {
+  using namespace microsoft;
+  uint8_t writes[32][4] = {};
+  uint32_t candidates[32][4] = {};
+  unsigned depth = 0, returns = 0;
+  bool safe = true;
+  D3D10ShaderBinary::CShaderCodeParser parser(code);
+  while (!parser.EndOfShader()) {
+    D3D10ShaderBinary::CInstruction inst;
+    parser.ParseInstruction(&inst);
+    switch (inst.OpCode()) {
+    case D3D10_SB_OPCODE_IF:
+    case D3D10_SB_OPCODE_LOOP:
+    case D3D10_SB_OPCODE_SWITCH:
+      ++depth;
+      break;
+    case D3D10_SB_OPCODE_ENDIF:
+    case D3D10_SB_OPCODE_ENDLOOP:
+    case D3D10_SB_OPCODE_ENDSWITCH:
+      if (depth) --depth; else safe = false;
+      break;
+    case D3D10_SB_OPCODE_RET:
+      ++returns;
+      if (depth || !parser.EndOfShader()) safe = false;
+      break;
+    case D3D10_SB_OPCODE_RETC:
+    case D3D10_SB_OPCODE_CALL:
+    case D3D10_SB_OPCODE_CALLC:
+    case D3D10_SB_OPCODE_LABEL:
+      safe = false;
+      break;
+    case D3D10_SB_OPCODE_DCL_OUTPUT:
+    case D3D10_SB_OPCODE_DCL_OUTPUT_SIV:
+    case D3D10_SB_OPCODE_DCL_OUTPUT_SGV:
+    case D3D10_SB_OPCODE_DCL_INDEX_RANGE:
+      continue;
+    default:
+      break;
+    }
+    for (unsigned operand = 0; operand < inst.NumOperands(); ++operand) {
+      const auto &dest = inst.m_Operands[operand];
+      if (dest.m_Type != D3D10_SB_OPERAND_TYPE_OUTPUT) continue;
+      if (dest.m_IndexType[0] != D3D10_SB_OPERAND_INDEX_IMMEDIATE32 ||
+          dest.m_Index[0].m_RegIndex >= 32) {
+        safe = false;
+        continue;
+      }
+      unsigned reg = dest.m_Index[0].m_RegIndex;
+      unsigned mask = dest.m_WriteMask >> 4;
+      bool literal = operand == 0 && inst.OpCode() == D3D10_SB_OPCODE_MOV &&
+                     inst.NumOperands() == 2 && !inst.m_bSaturate && depth == 0 &&
+                     inst.m_Operands[1].m_Type == D3D10_SB_OPERAND_TYPE_IMMEDIATE32 &&
+                     inst.m_Operands[1].m_Modifier == D3D10_SB_OPERAND_MODIFIER_NONE;
+      for (unsigned component = 0; component < 4; ++component) {
+        if (!(mask & (1u << component))) continue;
+        writes[reg][component] = std::min<unsigned>(2, writes[reg][component] + 1);
+        candidates[reg][component] = 0;
+        if (!literal || writes[reg][component] != 1) continue;
+        const auto &source = inst.m_Operands[1];
+        uint32_t bits = source.m_Value[source.m_NumComponents == D3D10_SB_OPERAND_4_COMPONENT ? component : 0];
+        if ((bits & 0x7f800000u) == 0x7f800000u && (bits & 0x007fffffu))
+          candidates[reg][component] = bits;
+      }
+    }
+  }
+  if (safe && returns == 1 && depth == 0)
+    std::memcpy(values, candidates, sizeof(candidates));
+}
