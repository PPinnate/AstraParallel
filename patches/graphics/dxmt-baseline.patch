+        const uint64_t span = uint64_t(p.rows - 1) * mapped.RowPitch + p.row_bytes;
+        if (!mapped.pData || mapped.RowPitch < p.row_bytes || span > p.staging_length ||
+            p.offset > total || p.bytes > total - p.offset) {
+          record.status = "invalid_mapped_row_bounds"; return;
+        }
+        record.phase = "copy_tight_subresource_rows";
+        for (uint32_t row = 0; row < p.rows; ++row)
+          std::memcpy(tight.data() + size_t(p.offset) + size_t(row) * p.row_bytes,
+            static_cast<const uint8_t *>(mapped.pData) + size_t(row) * mapped.RowPitch, p.row_bytes);
+        p.captured = true; ++record.subresources_captured;
