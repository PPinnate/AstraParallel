+inline void
+AstraGraphTrace::writeBurst(std::unique_ptr<Burst> data) noexcept {
+  int fd = -1;
+  bool owns_temporary = false;
+  std::string temporary;
+  try {
+    std::string json = serialize(*data);
+    if (json.size() > kBytes) {
+      // Defensive fallback if the schema is extended without updating the
+      // conservative per-record budgets. Drop all graph records together, so
+      // the valid bounded document cannot contain orphaned references.
+      data->truncated = data->incomplete = true;
+      data->dropped_commands += data->command_count; data->command_count = 0;
+      data->dropped_edges += data->edge_count; data->edge_count = 0;
+      data->dropped_definitions += data->definition_count; data->definition_count = 0;
+      data->json_budget = kEnvelopeBytes;
+      label(data->closure, "serialization_byte_limit");
+      json = serialize(*data);
+    }
+    if (json.size() > kBytes) {
+      report("ASG_FAILED pid=", data->pid, " ctx=", data->context, " nonce=", data->nonce,
+             " reason=serialization_envelope_limit");
+      return;
+    }
+    temporary = data->output_path + ".part";
+    fd = ::open(temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) {
+      report("ASG_FAILED pid=", data->pid, " ctx=", data->context, " nonce=", data->nonce,
+             " reason=exclusive_temporary_open errno=", errno);
+      return;
+    }
+    owns_temporary = true;
+    size_t written = 0;
+    bool failed = false;
+    while (written < json.size()) {
+      const ssize_t count = ::write(fd, json.data() + written, json.size() - written);
+      if (count > 0)
+        written += size_t(count);
+      else if (count == 0 || errno != EINTR) {
+        failed = true;
+        break;
+      }
+    }
+    if (::close(fd) != 0) failed = true;
+    fd = -1;
+    // link() publishes a complete file atomically and fails on any existing
+    // destination, including symlinks. Never truncate or overwrite evidence.
+    if (!failed && ::link(temporary.c_str(), data->output_path.c_str()) != 0)
+      failed = true;
+    const int failure_errno = errno;
+    ::unlink(temporary.c_str());
+    owns_temporary = false;
+    if (failed) {
+      report("ASG_FAILED pid=", data->pid, " ctx=", data->context, " nonce=", data->nonce,
+             " reason=write_or_exclusive_publish errno=", failure_errno);
+    } else {
+      report("ASG_WRITTEN pid=", data->pid, " ctx=", data->context, " session=", data->session,
+             " nonce=", data->nonce, " commands=", data->command_count, " edges=", data->edge_count,
+             " definitions=", data->definition_count, " bytes=", json.size(),
+             " truncated=", data->truncated, " incomplete=", data->incomplete);
+    }
+  } catch (...) {
+    if (fd >= 0) ::close(fd);
+    if (owns_temporary) ::unlink(temporary.c_str());
+    report("ASG_FAILED pid=", data->pid, " ctx=", data->context, " nonce=", data->nonce,
+           " reason=writer_exception");
+  }
+}
