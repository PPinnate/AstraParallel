+    record.all_subresources_captured = record.subresources_captured == record.subresources.size();
+    if (!record.all_subresources_captured) { record.status = "incomplete_subresources"; return; }
+    record.phase = "write_raw";
+    std::snprintf(record.raw_suffix, sizeof(record.raw_suffix), ".s%u.slot%u.raw", record.selector, record.slot);
+    int error = 0;
+    record.raw_written = exclusiveWrite(prefix_ + record.raw_suffix, tight.data(), tight.size(), error);
+    record.io_errno = error;
+    if (record.raw_written) {
+      written_bytes_ += total; record.status = "captured"; record.phase = "complete";
+    } else record.status = "raw_write_failed";
+  }
+
+  template <typename Context>
+  void captureSlot(Context &context, MTLD3D11Device *device, const D3D11ContextState &state, Record &record) {
+    if (monoNS() >= deadline_) { record.status = "expired_before_slot"; return; }
+    const auto &stage = state.ShaderStages[PipelineStage::Pixel];
+    auto *shader = stage.Shader ? stage.Shader->GetManagedShader() : nullptr;
+    if (!shader) { record.status = "no_effective_ps"; return; }
+    D3D11ResourceCommon *source = nullptr;
+    if (record.rtv_binding) {
+      const uint32_t slot = record.slot - 16;
+      uint32_t outputs = shader->reflection().PSValidRenderTargets;
+      if (state.OutputMerger.BlendState && state.OutputMerger.BlendState->IsDualSourceBlending())
+        outputs = (outputs & 3u) ? 1u : 0u;
+      if (!(outputs & (1u << slot))) { record.status = "rtv_not_declared_by_ps"; return; }
+      auto *view = slot < state.OutputMerger.NumRTVs ? state.OutputMerger.RTVs[slot].ptr() : nullptr;
+      if (!view || !view->resource_) { record.status = "unbound_rtv"; return; }
+      view->GetDesc1(&record.rtv_desc);
+      const auto &d = record.rtv_desc;
+      auto &v = record.view_desc;
+      v.Format = d.Format;
+      // Normalize only for the existing 2D readback validator. JSON retains
+      // the actual RTV view dimension and labels this as an OM binding.
+      if (d.ViewDimension == D3D11_RTV_DIMENSION_TEXTURE2D) {
+        v.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        v.Texture2D = {d.Texture2D.MipSlice, 1, d.Texture2D.PlaneSlice};
+      } else if (d.ViewDimension == D3D11_RTV_DIMENSION_TEXTURE2DARRAY) {
+        v.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DARRAY;
+        v.Texture2DArray = {d.Texture2DArray.MipSlice, 1, d.Texture2DArray.FirstArraySlice,
+                           d.Texture2DArray.ArraySize, d.Texture2DArray.PlaneSlice};
+      } else { record.status = "unsupported_rtv_view_dimension"; return; }
+      source = view->resource_.ptr();
+    } else {
+      if (!(shader->reflection().SRVSlotMaskLo & (uint64_t(1) << record.slot))) {
+        record.status = "slot_not_declared_by_ps"; return;
+      }
+      D3D11ShaderResourceView *view = nullptr;
+      for (const auto [slot, binding] : stage.SRVs)
+        if (slot == record.slot) { view = binding.SRV.ptr(); break; }
+      if (!view || !view->resource_) { record.status = "unbound_srv"; return; }
+      view->GetDesc1(&record.view_desc);
+      source = view->resource_.ptr();
+    }
+    record.resource_uid = source->graphUID(); record.tags = source->graphTags();
+    D3D11_RESOURCE_DIMENSION dimension = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+    source->GetType(&dimension); record.dimension = dimension;
+    if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+      record.status = "unsupported_resource_dimension"; return;
+    }
+    source->GetDesc(&record.resource_desc);
+    const auto &d = record.resource_desc;
+    const auto &v = record.view_desc;
+    if (!record.rtv_binding && (v.ViewDimension == D3D11_SRV_DIMENSION_TEXTURECUBE ||
+                               v.ViewDimension == D3D11_SRV_DIMENSION_TEXTURECUBEARRAY)) {
+      captureCube(context, device, source, record);
+      return;
+    }
+    if (d.ArraySize != 1 || d.SampleDesc.Count != 1 || d.SampleDesc.Quality != 0) {
+      record.status = "unsupported_array_or_multisample"; return;
+    }
+    if (d.BindFlags & D3D11_BIND_DEPTH_STENCIL) { record.status = "unsupported_depth_resource"; return; }
+    if (v.ViewDimension == D3D11_SRV_DIMENSION_TEXTURE2D) {
+      record.mip = v.Texture2D.MostDetailedMip; record.view_mips = v.Texture2D.MipLevels;
+      record.plane = v.Texture2D.PlaneSlice;
+    } else if (v.ViewDimension == D3D11_SRV_DIMENSION_TEXTURE2DARRAY &&
+               v.Texture2DArray.FirstArraySlice == 0 && v.Texture2DArray.ArraySize == 1) {
+      record.mip = v.Texture2DArray.MostDetailedMip; record.view_mips = v.Texture2DArray.MipLevels;
+      record.plane = v.Texture2DArray.PlaneSlice;
+    } else { record.status = "unsupported_view_dimension"; return; }
+    if (record.plane || !d.Width || !d.Height || !d.MipLevels || record.mip >= d.MipLevels ||
+        record.mip >= 32 || !record.view_mips ||
+        (record.view_mips != UINT_MAX && record.view_mips > d.MipLevels - record.mip)) {
+      record.status = "invalid_mip_or_plane"; return;
+    }
+    record.bytes_per_pixel = bytesPerPixel(v.Format, d.Format);
+    if (!record.bytes_per_pixel) { record.status = "unsupported_format_pair"; return; }
+    record.width = std::max(1u, d.Width >> record.mip);
+    record.height = std::max(1u, d.Height >> record.mip);
+    const uint64_t pixels = uint64_t(record.width) * record.height;
+    if (pixels > kPixels) { record.status = "pixel_limit"; return; }
+    record.row_bytes = record.width * record.bytes_per_pixel;
+    record.payload_bytes = pixels * record.bytes_per_pixel;
+    if (record.payload_bytes > kPayloadBytes || reserved_bytes_ > kPayloadBytes - record.payload_bytes) {
+      record.status = "payload_limit"; return;
+    }
+    reserved_bytes_ += record.payload_bytes;
+    record.phase = "allocation";
+    std::vector<uint8_t> tight(size_t(record.payload_bytes));
+    {
+      D3D11_TEXTURE2D_DESC staging_desc = d;
+      staging_desc.Width = record.width; staging_desc.Height = record.height;
+      staging_desc.MipLevels = staging_desc.ArraySize = 1;
+      staging_desc.SampleDesc = {1, 0};
+      staging_desc.Usage = D3D11_USAGE_STAGING;
+      staging_desc.BindFlags = staging_desc.MiscFlags = 0;
+      staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+      Com<ID3D11Texture2D> staging;
+      record.phase = "create_staging"; record.create_attempted = true;
+      record.create_hr = device->CreateTexture2D(&staging_desc, nullptr, &staging);
+      if (FAILED(record.create_hr) || !staging) { record.status = "staging_create_failed"; return; }
+      auto allocation = GetStagingResource(staging.ptr(), 0);
+      if (!allocation) { record.status = "staging_layout_unavailable"; return; }
+      const uint64_t copy_start = monoNS();
+      if (copy_start >= deadline_) { record.status = "expired_before_copy"; return; }
+      record.phase = "copy_and_map"; record.copy_start_mono = copy_start;
+      context.CopySubresourceRegion(staging.ptr(), 0, 0, 0, 0, source, record.mip, nullptr);
+      D3D11_MAPPED_SUBRESOURCE mapped{};
+      record.map_attempted = true;
+      record.map_hr = context.Map(staging.ptr(), 0, D3D11_MAP_READ, 0, &mapped);
+      if (FAILED(record.map_hr)) { record.status = "map_read_failed"; return; }
+      struct UnmapGuard {
+        Context &context; ID3D11Resource *resource;
+        ~UnmapGuard() { try { context.Unmap(resource, 0); } catch (...) {} }
+      } unmap{context, staging.ptr()};
+      record.mapped_row_pitch = mapped.RowPitch; record.mapped_depth_pitch = mapped.DepthPitch;
+      const uint64_t read_span = uint64_t(record.height - 1) * mapped.RowPitch + record.row_bytes;
+      if (!mapped.pData || mapped.RowPitch < record.row_bytes || read_span > allocation->length) {
+        record.status = "invalid_mapped_row_bounds"; return;
+      }
+      record.phase = "copy_tight_rows";
+      for (uint32_t row = 0; row < record.height; ++row)
+        std::memcpy(tight.data() + size_t(row) * record.row_bytes,
+          static_cast<const uint8_t *>(mapped.pData) + size_t(row) * mapped.RowPitch, record.row_bytes);
+    } // Unmap and release only the diagnostic staging resource before file I/O.
+    record.phase = "write_raw";
+    std::snprintf(record.raw_suffix, sizeof(record.raw_suffix), ".s%u.slot%u.raw", record.selector, record.slot);
+    int error = 0;
+    record.raw_written = exclusiveWrite(prefix_ + record.raw_suffix, tight.data(), tight.size(), error);
+    record.io_errno = error;
+    if (record.raw_written) {
+      written_bytes_ += record.payload_bytes; record.status = "captured"; record.phase = "complete";
+    } else record.status = "raw_write_failed";
+  }
+
+public:
+  AstraTextureSnapshot() = default;
+  AstraTextureSnapshot(const AstraTextureSnapshot &) = delete;
+  AstraTextureSnapshot &operator=(const AstraTextureSnapshot &) = delete;
+  ~AstraTextureSnapshot() { shutdown(); }
+  void initialize() noexcept {
+    if (initialized_) return;
+    initialized_ = true;
+    if (!startup_control_[0]) return;
+    try {
+      control_path_ = startup_control_.data();
+      pid_ = uint64_t(::getpid()); context_ = nextContext(); session_ = session(context_);
+      if (!context_ || !session_) { control_path_.clear(); return; }
+      report("ASTS_READY pid=", pid_, " ctx=", context_, " session=", session_,
+        " request=ASTS1_pid_ctx_session_nonce_pssha1_mask selection_mask_bits=24 max_textures=12 max_payload_bytes=67108864 lifetime_ms=5000");
+    } catch (...) { control_path_.clear(); }
+  }
+  bool active() const noexcept { return armed_.load(std::memory_order_relaxed); }
+  void boundary() noexcept {
+    if (inside_) return; // READ Map may recursively Flush; never arm/reenter there.
+    if (armed_) {
+      if (monoNS() >= deadline_) finish("expired");
+      return;
+    }
+    if (consumed_ || control_path_.empty()) return;
+    const uint64_t now = monoNS();
+    if (now < next_poll_) return;
+    next_poll_ = now + kPollNS;
+    Request request{};
+    if (!readRequest(request)) return;
+    consumed_ = true;
+    try {
+      request_ = request;
+      prefix_ = control_path_ + "." + std::to_string(pid_) + "." + std::to_string(context_) +
+        "." + std::to_string(request_.nonce);
+      armed_mono_ = monoNS(); armed_utc_ = utcNS(); deadline_ = armed_mono_ + kLifetimeNS;
+      armed_ = true;
+      report("ASTS_ACK pid=", pid_, " ctx=", context_, " session=", session_,
+        " nonce=", request_.nonce, " selectors=", request_.count, " diagnostic_readbacks_perturb_timing=1");
+    } catch (...) {
+      report("ASTS_FAILED pid=", pid_, " ctx=", context_, " reason=arm_exception");
+    }
+  }
+  template <typename Context>
+  void beforeDraw(Context &context, MTLD3D11Device *device, const D3D11ContextState &state,
+                  const char *kind) noexcept {
+    if (!armed_ || inside_) return;
+    if (monoNS() >= deadline_) { finish("expired"); return; }
+    struct ReentryGuard {
+      bool &inside;
+      explicit ReentryGuard(bool &flag) : inside(flag) { inside = true; }
+      ~ReentryGuard() { inside = false; }
+    } guard(inside_);
+    try {
+      const auto &stage = state.ShaderStages[PipelineStage::Pixel];
+      auto *shader = stage.Shader ? stage.Shader->GetManagedShader() : nullptr;
+      if (!shader) return;
+      auto so_layout = com_cast<IMTLD3D11StreamOutputLayout>(state.ShaderStages[PipelineStage::Geometry].Shader.ptr());
+      if (so_layout && so_layout->RasterizedStream() == D3D11_SO_NO_RASTERIZED_STREAM)
+        return; // A stale bound PS is not an effective pixel consumer.
+      const auto &digest = shader->sha1();
+      for (uint32_t i = 0; i < request_.count; ++i) {
+        auto &selector = request_.selectors[i];
+        if (selector.seen || std::memcmp(digest.data, selector.digest.data(), selector.digest.size())) continue;
+        selector.seen = true; // Consume once, including unsupported or failed slots.
+        for (uint32_t slot = 0; slot < 24; ++slot) {
+          if (!(selector.mask & (1u << slot))) continue;
+          if (record_count_ == records_.size()) { finish("texture_limit"); return; }
+          auto &record = records_[record_count_++];
+          record.selector = i; record.slot = slot; record.rtv_binding = slot >= 16; label(record.draw_kind, kind);
+          record.start_mono = monoNS(); record.start_utc = utcNS();
+          try { captureSlot(context, device, state, record); }
+          catch (...) { record.status = "diagnostic_exception"; }
+          publishRecord(record);
+        }
+      }
+      if (monoNS() >= deadline_) { finish("expired"); return; }
+      bool all_seen = true;
+      for (uint32_t i = 0; i < request_.count; ++i) all_seen &= request_.selectors[i].seen;
+      if (all_seen) finish("selectors_complete");
+    } catch (...) {
+      finish("diagnostic_exception");
+    }
+  }
+  void shutdown() noexcept {
+    finish(armed_ && monoNS() >= deadline_ ? "expired" : "context_shutdown");
+  }
+};
+
+} // namespace dxmt
+#endif
