+      v[5] = d.Texture1D.MostDetailedMip; v[6] = d.Texture1D.MipLevels; break;
+    case D3D11_SRV_DIMENSION_TEXTURE1DARRAY:
+      v[5] = d.Texture1DArray.MostDetailedMip; v[6] = d.Texture1DArray.MipLevels;
+      v[7] = d.Texture1DArray.FirstArraySlice; v[8] = d.Texture1DArray.ArraySize; break;
+    case D3D11_SRV_DIMENSION_TEXTURE2D:
+      v[5] = d.Texture2D.MostDetailedMip; v[6] = d.Texture2D.MipLevels; v[9] = d.Texture2D.PlaneSlice; break;
+    case D3D11_SRV_DIMENSION_TEXTURE2DARRAY:
+      v[5] = d.Texture2DArray.MostDetailedMip; v[6] = d.Texture2DArray.MipLevels;
+      v[7] = d.Texture2DArray.FirstArraySlice; v[8] = d.Texture2DArray.ArraySize;
+      v[9] = d.Texture2DArray.PlaneSlice; break;
+    case D3D11_SRV_DIMENSION_TEXTURE2DMS: break;
+    case D3D11_SRV_DIMENSION_TEXTURE2DMSARRAY:
+      v[7] = d.Texture2DMSArray.FirstArraySlice; v[8] = d.Texture2DMSArray.ArraySize; break;
+    case D3D11_SRV_DIMENSION_TEXTURE3D:
+      v[5] = d.Texture3D.MostDetailedMip; v[6] = d.Texture3D.MipLevels; break;
+    case D3D11_SRV_DIMENSION_TEXTURECUBE:
+      v[5] = d.TextureCube.MostDetailedMip; v[6] = d.TextureCube.MipLevels; v[8] = 6; break;
+    case D3D11_SRV_DIMENSION_TEXTURECUBEARRAY:
+      v[5] = d.TextureCubeArray.MostDetailedMip; v[6] = d.TextureCubeArray.MipLevels;
+      v[7] = d.TextureCubeArray.First2DArrayFace; v[8] = uint64_t(d.TextureCubeArray.NumCubes) * 6; break;
+    default: v[18] = 1; break;
+    }
+    if (view->buffer_) {
+      v[6] = v[8] = 0; v[12] = view->slice_.byteOffset; v[13] = view->slice_.byteLength; v[17] = 1;
+    }
+  }
+  static void fillView(Definition &value, D3D11UnorderedAccessView *view) {
+    D3D11_UNORDERED_ACCESS_VIEW_DESC1 d{}; view->GetDesc1(&d);
+    auto &v = value.values;
+    v[1] = 2; v[3] = d.Format; v[4] = d.ViewDimension;
+    switch (d.ViewDimension) {
+    case D3D11_UAV_DIMENSION_BUFFER:
+      v[10] = d.Buffer.FirstElement; v[11] = d.Buffer.NumElements; v[14] = d.Buffer.Flags; break;
+    case D3D11_UAV_DIMENSION_TEXTURE1D: v[5] = d.Texture1D.MipSlice; break;
+    case D3D11_UAV_DIMENSION_TEXTURE1DARRAY:
+      v[5] = d.Texture1DArray.MipSlice; v[7] = d.Texture1DArray.FirstArraySlice; v[8] = d.Texture1DArray.ArraySize; break;
+    case D3D11_UAV_DIMENSION_TEXTURE2D: v[5] = d.Texture2D.MipSlice; v[9] = d.Texture2D.PlaneSlice; break;
+    case D3D11_UAV_DIMENSION_TEXTURE2DARRAY:
+      v[5] = d.Texture2DArray.MipSlice; v[7] = d.Texture2DArray.FirstArraySlice;
+      v[8] = d.Texture2DArray.ArraySize; v[9] = d.Texture2DArray.PlaneSlice; break;
+    case D3D11_UAV_DIMENSION_TEXTURE3D:
+      v[5] = d.Texture3D.MipSlice; v[15] = d.Texture3D.FirstWSlice; v[16] = d.Texture3D.WSize; break;
+    default: v[18] = 1; break;
+    }
+    if (view->buffer_) {
+      v[6] = v[8] = 0; v[12] = view->slice_.byteOffset; v[13] = view->slice_.byteLength; v[17] = 1;
+    }
+  }
+  static void fillView(Definition &value, D3D11RenderTargetView *view) {
+    D3D11_RENDER_TARGET_VIEW_DESC1 d{}; view->GetDesc1(&d);
+    auto &v = value.values;
+    v[1] = 3; v[3] = d.Format; v[4] = d.ViewDimension;
+    switch (d.ViewDimension) {
+    case D3D11_RTV_DIMENSION_BUFFER:
+      v[6] = v[8] = 0; v[10] = d.Buffer.FirstElement; v[11] = d.Buffer.NumElements; v[18] = 1; break;
+    case D3D11_RTV_DIMENSION_TEXTURE1D: v[5] = d.Texture1D.MipSlice; break;
+    case D3D11_RTV_DIMENSION_TEXTURE1DARRAY:
+      v[5] = d.Texture1DArray.MipSlice; v[7] = d.Texture1DArray.FirstArraySlice; v[8] = d.Texture1DArray.ArraySize; break;
+    case D3D11_RTV_DIMENSION_TEXTURE2D: v[5] = d.Texture2D.MipSlice; v[9] = d.Texture2D.PlaneSlice; break;
+    case D3D11_RTV_DIMENSION_TEXTURE2DARRAY:
+      v[5] = d.Texture2DArray.MipSlice; v[7] = d.Texture2DArray.FirstArraySlice;
+      v[8] = d.Texture2DArray.ArraySize; v[9] = d.Texture2DArray.PlaneSlice; break;
+    case D3D11_RTV_DIMENSION_TEXTURE2DMS: break;
+    case D3D11_RTV_DIMENSION_TEXTURE2DMSARRAY:
+      v[7] = d.Texture2DMSArray.FirstArraySlice; v[8] = d.Texture2DMSArray.ArraySize; break;
+    case D3D11_RTV_DIMENSION_TEXTURE3D:
+      v[5] = d.Texture3D.MipSlice; v[15] = d.Texture3D.FirstWSlice; v[16] = d.Texture3D.WSize; break;
+    default: v[18] = 1; break;
+    }
+  }
+  static void fillView(Definition &value, D3D11DepthStencilView *view) {
+    D3D11_DEPTH_STENCIL_VIEW_DESC d{}; view->GetDesc(&d);
+    auto &v = value.values;
+    v[1] = 4; v[3] = d.Format; v[4] = d.ViewDimension; v[14] = d.Flags;
+    switch (d.ViewDimension) {
+    case D3D11_DSV_DIMENSION_TEXTURE1D: v[5] = d.Texture1D.MipSlice; break;
+    case D3D11_DSV_DIMENSION_TEXTURE1DARRAY:
+      v[5] = d.Texture1DArray.MipSlice; v[7] = d.Texture1DArray.FirstArraySlice; v[8] = d.Texture1DArray.ArraySize; break;
+    case D3D11_DSV_DIMENSION_TEXTURE2D: v[5] = d.Texture2D.MipSlice; break;
+    case D3D11_DSV_DIMENSION_TEXTURE2DARRAY:
+      v[5] = d.Texture2DArray.MipSlice; v[7] = d.Texture2DArray.FirstArraySlice; v[8] = d.Texture2DArray.ArraySize; break;
+    case D3D11_DSV_DIMENSION_TEXTURE2DMS: break;
+    case D3D11_DSV_DIMENSION_TEXTURE2DMSARRAY:
+      v[7] = d.Texture2DMSArray.FirstArraySlice; v[8] = d.Texture2DMSArray.ArraySize; break;
+    default: v[18] = 1; break;
+    }
+  }
+  template <typename View>
+  uint32_t viewDefinition(View *view) {
+    if (!burst_ || !view)
+      return 0;
+    auto *resource = view->resource_.ptr();
+    if (!resourceDefinition(resource) || !burst_)
+      return 0;
+    Definition value{};
+    value.kind = ViewDef; value.count = 19;
+    value.values[0] = resource->graphUID();
+    value.values[2] = view->viewId();
+    value.values[6] = value.values[8] = 1;
+    fillView(value, view);
+    if (value.values[18])
+      burst_->incomplete = true;
+    return definition(value);
+  }
+  uint32_t shaderDefinition(Shader *shader, uint32_t stage) {
+    if (!burst_ || !shader)
+      return 0;
+    const auto &reflection = shader->reflection();
+    Definition value{};
+    value.kind = ShaderDef; value.count = 7;
+    value.values[0] = stage; value.values[1] = reflection.ConstantBufferSlotMask;
+    value.values[2] = reflection.SamplerSlotMask; value.values[3] = reflection.SRVSlotMaskLo;
+    value.values[4] = reflection.SRVSlotMaskHi; value.values[5] = reflection.UAVSlotMask;
+    value.values[6] = stage == 1 ? reflection.PSValidRenderTargets : 0;
+    std::memcpy(value.sha1.data(), shader->sha1().data, value.sha1.size());
+    return definition(value);
+  }
+  uint32_t samplerDefinition(D3D11SamplerState *sampler) {
+    if (!burst_ || !sampler)
+      return 0;
+    D3D11_SAMPLER_DESC d{}; sampler->GetDesc(&d);
+    Definition value{};
+    value.kind = SamplerDef; value.count = 13;
+    auto &v = value.values;
+    v[0] = d.Filter; v[1] = d.AddressU; v[2] = d.AddressV; v[3] = d.AddressW;
+    v[4] = floatBits(d.MipLODBias); v[5] = d.MaxAnisotropy; v[6] = d.ComparisonFunc;
+    for (size_t i = 0; i < 4; ++i) v[7 + i] = floatBits(d.BorderColor[i]);
+    v[11] = floatBits(d.MinLOD); v[12] = floatBits(d.MaxLOD);
+    return definition(value);
+  }
+  void edge(uint32_t commandID, uint32_t role, uint64_t resourceUID, uint32_t definitionID,
+            uint32_t stage = kUnknown, uint32_t slot = kUnknown, uint32_t subresource = kUnknown,
+            uint64_t offset = 0, uint64_t length = 0, uint64_t flags = 0) {
+    if (!burst_ || !commandID || (!definitionID && role != MissingBinding))
+      return;
+    if (burst_->texture_only && role == MissingBinding &&
+        (flags == DeclaredCB || flags == VertexInput || flags == IndexInput || flags == IndirectInput || flags == SOReadWrite)) {
+      ++burst_->omitted_buffer_bindings;
+      return;
+    }
+    if (burst_->edge_count == kEdges) {
+      ++burst_->dropped_edges;
+      finish("edge_limit", true, true);
+      return;
+    }
+    if (!budget(kEdgeBytes, "byte_limit_edges", &Burst::dropped_edges))
+      return;
+    burst_->edges[burst_->edge_count++].values = {
+      commandID, role, resourceUID, definitionID, stage, slot, subresource, offset, length, flags,
+      burst_->segments
+    };
+  }
+  void resourceEdge(uint32_t commandID, uint32_t role, D3D11ResourceCommon *resource,
+                    uint32_t stage = kUnknown, uint32_t slot = kUnknown, uint32_t sub = kUnknown,
+                    uint64_t offset = 0, uint64_t length = 0, uint64_t flags = 0) {
+    if (!burst_ || !resource)
+      return;
+    if (burst_->texture_only && isBuffer(resource)) {
+      ++burst_->omitted_buffer_bindings;
+      return;
+    }
+    const uint64_t uid = resource->graphUID();
+    const auto id = resourceDefinition(resource);
+    edge(commandID, role, uid, id, stage, slot, sub, offset, length, flags);
+  }
+  template <typename View>
+  void viewEdge(uint32_t commandID, uint32_t role, View *view, uint32_t stage = kUnknown,
+                uint32_t slot = kUnknown, uint64_t flags = 0) {
+    if (!burst_ || !view)
+      return;
+    if (burst_->texture_only && isBuffer(view->resource_.ptr())) {
+      ++burst_->omitted_buffer_bindings;
+      return;
+    }
+    const uint64_t uid = view->resource_ ? view->resource_->graphUID() : 0;
+    const auto id = viewDefinition(view);
+    edge(commandID, role, uid, id, stage, slot, kUnknown, 0, 0, flags);
+  }
+
+  // Serialization and publication run only on the owned writer thread.
+  static std::string serialize(Burst &data);
+  static void writeBurst(std::unique_ptr<Burst> data) noexcept;
+  void finish(const char *reason, bool truncated, bool incomplete) {
+    if (!burst_)
+      return;
+    burst_->end_mono = monoNS(); burst_->end_utc = utcNS();
+    burst_->truncated |= truncated; burst_->incomplete |= incomplete;
+    label(burst_->closure, reason);
+    if (minlod_reader_)
+      burst_->minlod_end = minlod_reader_();
+    auto data = std::move(burst_);
+    try {
+      writer_ = std::thread(&AstraGraphTrace::writeBurst, std::move(data));
+    } catch (...) {
+      report("ASG_FAILED pid=", pid_, " ctx=", context_, " session=", session_, " reason=writer_start");
+    }
+  }
+
+public:
+  AstraGraphTrace() = default;
+  AstraGraphTrace(const AstraGraphTrace &) = delete;
+  AstraGraphTrace &operator=(const AstraGraphTrace &) = delete;
+  ~AstraGraphTrace() { shutdown(); }
+
+  void initialize(MinLODReader reader) {
+    if (initialized_)
+      return;
+    initialized_ = true;
+    if (!GraphResourceCaptureEnabled() || !startup_control_[0])
+      return;
+    try {
+      control_path_ = startup_control_.data();
+      pid_ = uint64_t(::getpid()); context_ = contextID(); session_ = sessionID(context_);
+      if (!context_ || !session_) {
+        control_path_.clear();
+        return;
+      }
+      minlod_reader_ = reader;
+      report("ASG_READY pid=", pid_, " ctx=", context_, " session=", session_,
+           " request=ASG1_pid_ctx_session_nonce duration_ms=500 once_per_context=1 texture_only=", startup_texture_only_);
+    } catch (...) {
+      control_path_.clear();
+    }
+  }
+  bool active() const noexcept { return bool(burst_); }
+  void boundary(const char *kind) {
+    if (burst_) {
+      if (!withinWindow())
+        return;
+      if (!command(kind))
+        return;
+      ++burst_->segments;
+      return;
+    }
+    if (control_path_.empty() || consumed_)
+      return;
+    const uint64_t now = monoNS();
+    if (now < next_poll_)
+      return;
+    next_poll_ = now + kPollNS;
+    uint64_t nonce = 0;
+    if (!readRequest(nonce))
+      return;
+    consumed_ = true;
+    try {
+      auto data = std::make_unique<Burst>();
+      data->pid = pid_; data->context = context_; data->session = session_; data->nonce = nonce;
+      data->texture_only = startup_texture_only_;
+      data->incomplete = data->texture_only; // Buffer provenance is intentionally outside this mode.
+      data->output_path = control_path_ + "." + std::to_string(pid_) + "." +
+        std::to_string(context_) + "." + std::to_string(nonce) + ".json";
+      if (minlod_reader_) data->minlod_start = minlod_reader_();
+      data->start_mono = monoNS(); data->start_utc = utcNS();
+      burst_ = std::move(data);
+      report("ASG_ACK pid=", pid_, " ctx=", context_, " session=", session_, " nonce=", nonce);
+      command("capture_start_after_flush");
+    } catch (...) {
+      burst_.reset();
+      report("ASG_FAILED pid=", pid_, " ctx=", context_, " session=", session_, " reason=arm_allocation");
+    }
+  }
+  void shutdown() {
+    if (burst_)
+      finish("context_shutdown", false, true);
+    if (writer_.joinable())
+      writer_.join();
+  }
+  void marker(const char *kind, bool incomplete = false) {
+    if (!burst_)
+      return;
+    if (burst_->texture_only && kind && (!std::strcmp(kind, "map_tracking_capacity") ||
+        !std::strcmp(kind, "unmap_access_not_tracked") || !std::strcmp(kind, "map_access_type_unknown"))) {
+      if (withinWindow(true)) ++burst_->omitted_tracking_markers;
+      return;
+    }
+    if (command(kind) && burst_)
+      burst_->incomplete |= incomplete;
+  }
+  void resources(const char *kind, ID3D11Resource *dst, UINT dstSub,
+                 ID3D11Resource *src = nullptr, UINT srcSub = UINT_MAX,
+                 const D3D11_BOX *srcBox = nullptr, UINT dstX = 0, UINT dstY = 0,
+                 UINT dstZ = 0, UINT flags = 0) {
+    if (!burst_)
+      return;
+    if (burst_->texture_only && (dst || src) && (!dst || isBuffer(dst)) && (!src || isBuffer(src))) {
+      if (withinWindow(true)) ++burst_->omitted_buffer_commands;
+      return;
+    }
+    const auto id = command(kind, 0, flags);
+    if (!id)
+      return;
+    auto &entry = burst_->commands[id - 1];
+    entry.src_sub = srcSub; entry.dst_sub = dstSub;
+    entry.dst_xyz[0] = dstX; entry.dst_xyz[1] = dstY; entry.dst_xyz[2] = dstZ;
+    if (srcBox) {
+      entry.has_box = 1; entry.box[0] = srcBox->left; entry.box[1] = srcBox->top; entry.box[2] = srcBox->front;
+      entry.box[3] = srcBox->right; entry.box[4] = srcBox->bottom; entry.box[5] = srcBox->back;
+    }
+    resourceEdge(id, CopyRead, GetResourceCommon(src), kUnknown, kUnknown, srcSub);
+    resourceEdge(id, src ? CopyWrite : ExternalWrite, GetResourceCommon(dst), kUnknown, kUnknown, dstSub);
+  }
+  template <typename View>
+  void view(const char *kind, View *target, UINT flags = 0, const D3D11_RECT *rect = nullptr) {
+    static_assert(std::is_same_v<View, D3D11ShaderResourceView> ||
+                  std::is_same_v<View, D3D11UnorderedAccessView> ||
+                  std::is_same_v<View, D3D11RenderTargetView> ||
+                  std::is_same_v<View, D3D11DepthStencilView>);
+    if (!burst_)
+      return;
+    if (burst_->texture_only && target && isBuffer(target->resource_.ptr())) {
+      if (withinWindow(true)) ++burst_->omitted_buffer_commands;
+      return;
+    }
+    const auto id = command(kind, 0, flags);
+    if (!id)
+      return;
+    if (rect) {
+      auto &entry = burst_->commands[id - 1];
+      entry.has_rect = 1; entry.rect[0] = rect->left; entry.rect[1] = rect->top;
+      entry.rect[2] = rect->right; entry.rect[3] = rect->bottom;
+    }
+    viewEdge(id, ViewReadWrite, target, kUnknown, kUnknown, flags);
+  }
+  void pipeline(const D3D11ContextState &state, bool compute, const char *kind, uint32_t pipelineKind = 0,
+                ID3D11Buffer *indirect = nullptr, UINT indirectOffset = 0,
+                bool rasterizationEnabled = true, bool depthStencilEnabled = true) {
+    if (!burst_)
+      return;
+    const uint32_t graphicsStages = 1u | (rasterizationEnabled ? 2u : 0u) |
+      (pipelineKind == 2 ? 24u : pipelineKind == 3 ? 4u : 0u);
+    const uint32_t activeStages = compute ? 32u : graphicsStages;
+    auto *pixelShader = !compute && rasterizationEnabled && state.ShaderStages[PipelineStage::Pixel].Shader ?
+      state.ShaderStages[PipelineStage::Pixel].Shader->GetManagedShader() : nullptr;
+    uint32_t colorMask = pixelShader ? pixelShader->reflection().PSValidRenderTargets : 0;
+    const bool dualSource = !compute && state.OutputMerger.BlendState && state.OutputMerger.BlendState->IsDualSourceBlending();
+    if (dualSource) colorMask &= 1u; // Secondary PS output 1 belongs to RTV0, never RTV1.
+    colorMask &= 0xffu;
+    if (burst_->texture_only) {
+      uint64_t outputUAVMask = 0;
+      for (uint32_t stage = 0; stage < 6; ++stage) {
+        if (!(activeStages & (1u << stage))) continue;
+        const auto &binding = state.ShaderStages[PipelineStage(stage)].Shader;
+        auto *shader = binding ? binding->GetManagedShader() : nullptr;
+        if (shader) outputUAVMask |= shader->reflection().UAVSlotMask;
+      }
+      bool textureOutput = !compute && rasterizationEnabled && depthStencilEnabled && bool(state.OutputMerger.DSV);
+      for (uint32_t slot = 0; slot < D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT && !textureOutput; ++slot)
+        textureOutput = !compute && (colorMask & (1u << slot)) && state.OutputMerger.RTVs[slot] &&
+          !isBuffer(state.OutputMerger.RTVs[slot]->resource_.ptr());
+      const auto &uavs = compute ? state.ComputeStageUAV.UAVs : state.OutputMerger.UAVs;
+      for (const auto [slot, binding] : uavs)
+        if ((outputUAVMask & (uint64_t(1) << slot)) && binding.View && !isBuffer(binding.View->resource_.ptr()))
+          textureOutput = true;
+      if (!textureOutput) {
+        if (withinWindow(true)) ++burst_->omitted_no_texture_output_commands;
+        return;
+      }
+    }
+    const uint32_t graphFlags = (compute ? 1u : 0u) | (!compute && rasterizationEnabled ? 2u : 0u) |
+      (!compute && rasterizationEnabled && depthStencilEnabled ? 4u : 0u) | (colorMask << 8) | (dualSource ? 65536u : 0u);
+    const auto id = command(kind, pipelineKind, graphFlags);
+    if (!id)
+      return;
+    burst_->predicate_seen |= bool(state.predicate);
+    if (!compute && pipelineKind != 1 && pipelineKind != 2 && pipelineKind != 3)
+      burst_->incomplete = true;
+    if (!compute && pipelineKind == 1 && state.ShaderStages[PipelineStage::Geometry].Shader)
+      burst_->ordinary_gs_bound = true;
+    uint64_t declaredUAVs = 0;
+    for (uint32_t stage = compute ? 5 : 0; stage < (compute ? 6u : 5u) && burst_; ++stage) {
+      if (!(activeStages & (1u << stage)))
+        continue;
+      const auto &bindings = state.ShaderStages[PipelineStage(stage)];
+      auto *shader = bindings.Shader ? bindings.Shader->GetManagedShader() : nullptr;
+      if (!shader)
+        continue;
+      const auto &reflection = shader->reflection();
+      declaredUAVs |= reflection.UAVSlotMask;
+      edge(id, ShaderBinding, 0, shaderDefinition(shader, stage), stage);
+      for (const auto [slot, binding] : bindings.SRVs) {
+        if (!burst_) return;
+        const auto mask = slot < 64 ? reflection.SRVSlotMaskLo : reflection.SRVSlotMaskHi;
+        if (mask & (uint64_t(1) << (slot % 64))) {
+          if (binding.SRV)
+            viewEdge(id, DeclaredSRV, binding.SRV.ptr(), stage, uint32_t(slot));
+          else
+            edge(id, MissingBinding, 0, 0, stage, uint32_t(slot), kUnknown, 0, 0, DeclaredSRV);
+        }
+      }
+      for (const auto [slot, binding] : bindings.ConstantBuffers) {
+        if (!burst_) return;
+        if (reflection.ConstantBufferSlotMask & (uint64_t(1) << slot)) {
+          if (binding.Buffer)
+            resourceEdge(id, DeclaredCB, binding.Buffer.ptr(), stage, uint32_t(slot), kUnknown,
+                         uint64_t(binding.FirstConstant) * 16, uint64_t(binding.NumConstants) * 16);
+          else
+            edge(id, MissingBinding, 0, 0, stage, uint32_t(slot), kUnknown, 0, 0, DeclaredCB);
+        }
+      }
+      for (const auto [slot, binding] : bindings.Samplers) {
+        if (!burst_) return;
+        if (reflection.SamplerSlotMask & (uint64_t(1) << slot)) {
+          if (binding.Sampler)
+            edge(id, SamplerBinding, 0, samplerDefinition(binding.Sampler), stage, uint32_t(slot));
+          else
+            edge(id, MissingBinding, 0, 0, stage, uint32_t(slot), kUnknown, 0, 0, SamplerBinding);
+        }
+      }
+      // BindingSet's const iterator only visits bound slots. Explicitly retain
+      // reflection-declared null slots without inventing a resource identity.
+      for (uint32_t slot = 0; slot < 128 && burst_; ++slot) {
+        const auto mask = slot < 64 ? reflection.SRVSlotMaskLo : reflection.SRVSlotMaskHi;
+        if ((mask & (uint64_t(1) << (slot % 64))) && !bindings.SRVs.test_bound(slot))
+          edge(id, MissingBinding, 0, 0, stage, slot, kUnknown, 0, 0, DeclaredSRV);
+      }
+      for (uint32_t slot = 0; slot < 14 && burst_; ++slot) {
+        if ((reflection.ConstantBufferSlotMask & (uint64_t(1) << slot)) &&
+            !bindings.ConstantBuffers.test_bound(slot))
+          edge(id, MissingBinding, 0, 0, stage, slot, kUnknown, 0, 0, DeclaredCB);
+      }
+      for (uint32_t slot = 0; slot < 16 && burst_; ++slot) {
+        if ((reflection.SamplerSlotMask & (uint64_t(1) << slot)) && !bindings.Samplers.test_bound(slot))
+          edge(id, MissingBinding, 0, 0, stage, slot, kUnknown, 0, 0, SamplerBinding);
+      }
+    }
+    if (!burst_) return;
+    if (compute) {
+      for (const auto [slot, binding] : state.ComputeStageUAV.UAVs) {
+        if (!burst_) return;
+        if (declaredUAVs & (uint64_t(1) << slot)) {
+          if (binding.View)
+            viewEdge(id, UAVReadWrite, binding.View.ptr(), 5, uint32_t(slot));
+          else
+            edge(id, MissingBinding, 0, 0, 5, uint32_t(slot), kUnknown, 0, 0, UAVReadWrite);
+        }
+      }
+      for (uint32_t slot = 0; slot < 64 && burst_; ++slot) {
+        if ((declaredUAVs & (uint64_t(1) << slot)) && !state.ComputeStageUAV.UAVs.test_bound(slot))
+          edge(id, MissingBinding, 0, 0, 5, slot, kUnknown, 0, 0, UAVReadWrite);
+      }
+    } else {
+      for (uint32_t slot = 0; slot < D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT && burst_; ++slot)
+        if (rasterizationEnabled && (colorMask & (1u << slot)))
+          viewEdge(id, RTVReadWrite, state.OutputMerger.RTVs[slot].ptr(), 1, slot);
+      if (rasterizationEnabled && depthStencilEnabled)
+        viewEdge(id, DSVReadWrite, state.OutputMerger.DSV.ptr(), 1);
+      for (const auto [slot, binding] : state.OutputMerger.UAVs) {
+        if (!burst_) return;
+        if (declaredUAVs & (uint64_t(1) << slot)) {
+          if (binding.View)
+            viewEdge(id, UAVReadWrite, binding.View.ptr(), kUnknown, uint32_t(slot));
+          else
+            edge(id, MissingBinding, 0, 0, kUnknown, uint32_t(slot), kUnknown, 0, 0, UAVReadWrite);
+        }
+      }
+      for (uint32_t slot = 0; slot < 64 && burst_; ++slot) {
+        if ((declaredUAVs & (uint64_t(1) << slot)) && !state.OutputMerger.UAVs.test_bound(slot))
+          edge(id, MissingBinding, 0, 0, kUnknown, slot, kUnknown, 0, 0, UAVReadWrite);
+      }
+      for (const auto [slot, binding] : state.StreamOutput.Targets)
+        resourceEdge(id, SOReadWrite, binding.Buffer.ptr(), kUnknown, uint32_t(slot), kUnknown, binding.Offset);
+      if (!burst_) return;
+      auto *layout = state.InputAssembler.InputLayout ?
+        state.InputAssembler.InputLayout->GetManagedInputLayout() : nullptr;
+      const uint32_t vertexSlots = layout ? layout->input_slot_mask() : 0;
+      if (vertexSlots & 0xffff0000u) burst_->incomplete = true;
+      for (const auto [slot, binding] : state.InputAssembler.VertexBuffers) {
+        if (!burst_) return;
+        if (vertexSlots & (1u << slot)) {
+          if (binding.Buffer)
+            resourceEdge(id, VertexInput, binding.Buffer.ptr(), 0, uint32_t(slot), kUnknown,
+                         binding.Offset, 0, binding.Stride);
+          else
+            edge(id, MissingBinding, 0, 0, 0, uint32_t(slot), kUnknown, 0, 0, VertexInput);
+        }
+      }
+      for (uint32_t slot = 0; slot < 16 && burst_; ++slot) {
+        if ((vertexSlots & (1u << slot)) && !state.InputAssembler.VertexBuffers.test_bound(slot))
+          edge(id, MissingBinding, 0, 0, 0, slot, kUnknown, 0, 0, VertexInput);
+      }
+      const bool indexed = kind && (!std::strcmp(kind, "draw_indexed") ||
+        !std::strcmp(kind, "draw_indexed_instanced") || !std::strcmp(kind, "draw_indexed_indirect"));
+      if (indexed) {
+        if (state.InputAssembler.IndexBuffer)
+          resourceEdge(id, IndexInput, state.InputAssembler.IndexBuffer.ptr(), 0, kUnknown, kUnknown,
+                       state.InputAssembler.IndexBufferOffset, 0, state.InputAssembler.IndexBufferFormat);
+        else
+          edge(id, MissingBinding, 0, 0, 0, kUnknown, kUnknown, 0, 0, IndexInput);
+      }
+    }
+    resourceEdge(id, IndirectInput, GetResourceCommon(indirect), compute ? 5 : 0, kUnknown,
+                 kUnknown, indirectOffset);
+  }
+};
