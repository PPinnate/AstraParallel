+// Shared across the immediate/deferred template instantiations: at most 16
+// call records per worker. Counters remain available to a separately bounded
+// timed metadata marker; they contain no resource identity or contents.
+struct AstraMinLODCallMetadata {
+  std::atomic<uint64_t> total{0}, zero{0}, positive{0}, other{0};
+  std::atomic<uint32_t> records{0};
+};
+inline AstraMinLODCallMetadata &AstraMinLODMetadata() {
+  static AstraMinLODCallMetadata metadata;
+  return metadata;
+}
+inline void AstraTraceResourceMinLOD(ID3D11Resource *resource, float value) {
+  auto &metadata = AstraMinLODMetadata();
+  const auto call = metadata.total.fetch_add(1, std::memory_order_relaxed) + 1;
+  const bool positive = value > 0;
+  (positive ? metadata.positive : value == 0 ? metadata.zero : metadata.other)
+      .fetch_add(1, std::memory_order_relaxed);
+  // A single initial zero/other record establishes call-path activation;
+  // later zero calls cannot consume the remaining positive-call budget.
+  if (!positive && call != 1)
+    return;
+  auto record = metadata.records.load(std::memory_order_relaxed);
+  while (record < 16 && !metadata.records.compare_exchange_weak(
+                           record, record + 1, std::memory_order_relaxed)) {}
+  if (record >= 16)
+    return;
+  D3D11_RESOURCE_DIMENSION dimension = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+  UINT width = 0, height = 0, depth = 0, mips = 0, array = 0, misc = 0;
+  const char *kind = resource ? "unknown" : "null";
+  if (resource) {
+    resource->GetType(&dimension);
+    auto common = GetResourceCommon(resource);
+    switch (dimension) {
+    case D3D11_RESOURCE_DIMENSION_BUFFER: {
+      D3D11_BUFFER_DESC desc{}; common->GetDesc(&desc);
+      kind = "buffer"; misc = desc.MiscFlags; break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE1D: {
+      D3D11_TEXTURE1D_DESC desc{}; common->GetDesc(&desc);
+      kind = "texture1d"; width = desc.Width; height = depth = 1;
+      mips = desc.MipLevels; array = desc.ArraySize; misc = desc.MiscFlags; break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE2D: {
+      D3D11_TEXTURE2D_DESC desc{}; common->GetDesc(&desc);
+      kind = "texture2d"; width = desc.Width; height = desc.Height; depth = 1;
+      mips = desc.MipLevels; array = desc.ArraySize; misc = desc.MiscFlags; break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE3D: {
+      D3D11_TEXTURE3D_DESC desc{}; common->GetDesc(&desc);
+      kind = "texture3d"; width = desc.Width; height = desc.Height; depth = desc.Depth;
+      mips = desc.MipLevels; array = 1; misc = desc.MiscFlags; break;
+    }
+    default: break;
+    }
+  }
+  WARN("AstraMinLODCall record=", record + 1, " cap=16 call=", call,
+       " positive=", metadata.positive.load(std::memory_order_relaxed),
+       " zero=", metadata.zero.load(std::memory_order_relaxed),
+       " other=", metadata.other.load(std::memory_order_relaxed),
+       " value=", value, " kind=", kind, " size=", width, "x", height, "x", depth,
+       " mips=", mips, " array=", array,
+       " resource_clamp=", !!(misc & D3D11_RESOURCE_MISC_RESOURCE_CLAMP));
+}
+
+inline AstraGraphMinLODCounts AstraGraphReadMinLODCounts() {
+  auto &m = AstraMinLODMetadata();
+  return {m.total.load(std::memory_order_relaxed), m.zero.load(std::memory_order_relaxed),
+          m.positive.load(std::memory_order_relaxed), m.other.load(std::memory_order_relaxed)};
+}
 
